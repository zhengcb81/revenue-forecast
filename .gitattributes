# Force LF line endings for CI consistency (Linux GitHub Actions)
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf

# Hook scripts must stay LF (CRLF shebang breaks git hook spawn on Windows)
/.githooks/** text eol=lf

