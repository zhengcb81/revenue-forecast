[run]
branch = True
source = scripts
concurrency = multiprocessing
parallel = True
sigterm = True

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.
    raise NotImplementedError
# G2-RF-TOOLS: historical report decoder only — uc.quality._revenue_coverage
# reads this number for the frozen report.  It no longer decides qualification,
# and low measured numbers stay diagnostics (see tools/run_coverage_gates.py).
fail_under = 0
show_missing = True

[html]
directory = .coverage_html
