#!/bin/sh
# Pre-push runs the fast local correctness gates. The blocking CI workflow
# runs the sibling-repository E2E suite; production-catalog checks remain an
# explicit local milestone check. This avoids repeating multi-minute suites
# synchronously on every push.
#
# Installed as .githooks/pre-push (git config core.hooksPath .githooks).
# Every `git push` runs the fast gate first; a red fast gate aborts the push.
# CI and this hook invoke the same bounded behavior set.
#
# NOTE: shebang MUST be #!/bin/sh (git-for-windows spawns /bin/sh hooks
# natively; /usr/bin/env bash failed with "cannot spawn").  Use
# `python`, not python3, on Windows.

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ ! -f "$ROOT/tools/pre_push_gate.py" ]; then
  echo "pre-push gate: tools/pre_push_gate.py missing - skipping" >&2
  exit 0
fi

python "$ROOT/tools/pre_push_gate.py"
rc=$?
if [ "$rc" -ne 0 ]; then
  echo "" >&2
  echo "PUSH BLOCKED by pre-push gate (CI root-fix protocol). Fix the root cause; do not bypass." >&2
fi
exit "$rc"
