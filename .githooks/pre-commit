#!/bin/sh
# Run the configured pre-commit gates using this checkout's current toolchain.
# No machine-specific Python/Git installation paths and no Bash-only arrays.

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export PATHEXT="${PATHEXT:-.COM;.EXE;.BAT;.CMD}"
# Resolve Git before handing PATH to a Python child; MSYS keeps this in its
# native POSIX form rather than mangling a hardcoded Windows path.
git_command=$(command -v git || true)
if [ -n "$git_command" ]; then
    git_bin_dir=$(dirname -- "$git_command")
    export PATH="$git_bin_dir:$PATH"
fi
unset MSYS_NO_PATHCONV

python_command=$(command -v python || command -v python3 || true)
if [ -n "$python_command" ]; then
    exec "$python_command" -m pre_commit hook-impl --config=.pre-commit-config.yaml \
        --hook-type=pre-commit --hook-dir "$HERE" -- "$@"
elif command -v pre-commit >/dev/null 2>&1; then
    exec pre-commit hook-impl --config=.pre-commit-config.yaml \
        --hook-type=pre-commit --hook-dir "$HERE" -- "$@"
else
    echo 'pre-commit not found in the current toolchain; install it before committing.' >&2
    exit 1
fi
