#!/usr/bin/env bash
# revenue-forecast pre-commit gate: test suite + engine E2E.
# Installed via: git config core.hooksPath .githooks
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

echo "[pre-commit] running test suite..."
python -m pytest "$ROOT/tests" -q

echo "[pre-commit] running engine E2E..."
python "$ROOT/e2e/run_revenue_forecast_e2e.py"

echo "[pre-commit] checking installation sync (R4.2)..."
python "$ROOT/tools/sync_installations.py"
