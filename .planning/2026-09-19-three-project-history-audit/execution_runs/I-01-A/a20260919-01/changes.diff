+def _effective_config_checks(config, problems: list[str]) -> None:
+    """D-W01: doctor and the real scan share ONE effective-config judgment
+    (``effective_root_profile`` in source_catalog/config.py).
+
+    The scan's v2/v1 decision is read exactly the way ``SourceCatalog.scan``
+    reads it (``scanner.v2_scan_shadow_from_snapshot``), so the doctor's
+    per-root adapter/profile/version/read-write classification cannot drift
+    from what the scan would do.  Policy-level half-activation (legacy
+    bridge mixed with active v2 flags) is listed once under
+    root ``runtime_policy``.
+    """
+    from company_wiki.source_catalog.config import (
+        effective_policy_profile,
+        effective_root_profile,
+    )
+    from company_wiki.source_catalog.scanner import v2_scan_shadow_from_snapshot
+
+    shadow = v2_scan_shadow_from_snapshot(config.catalog_dir)
+    flags = _runtime_policy_flags(config.catalog_dir)
+    for policy_error in effective_policy_profile(flags):
+        problems.append(
+            "root 'runtime_policy' adapter_id=None effective-config: {}, {}".format(
+                policy_error["code"], policy_error["detail"]
+            )
+        )
+    for root_spec in config.roots:
+        profile = effective_root_profile(root_spec, scan_shadow_active=shadow)
+        for error in profile["errors"]:
+            problems.append(
+                "root '{}' adapter_id={!r} effective-config: {}, {}".format(
+                    root_spec.root_id,
+                    root_spec.adapter_id,
+                    error["code"],
+                    error["detail"],
+                )
+            )
+
+
+def _runtime_policy_flags(catalog_dir) -> dict | None:
+    """Flags dict for the policy-level bridge check, or None when the
+    snapshot is absent/invalid (the same degrade-to-v1 rule the scan uses;
+    the scan shadow flag itself comes from scanner.v2_scan_shadow_from_snapshot)."""
+    from company_wiki.source_catalog.runtime_policy import (
+        RuntimePolicyError,
+        load_runtime_policy,
+    )
+
+    snapshot_path = Path(catalog_dir) / "runtime_policy.json"
+    if not snapshot_path.is_file():
+        return None
+    try:
+        return load_runtime_policy(snapshot_path).get("flags")
+    except (RuntimePolicyError, KeyError, TypeError, ValueError, OSError):
+        return None
 
 
