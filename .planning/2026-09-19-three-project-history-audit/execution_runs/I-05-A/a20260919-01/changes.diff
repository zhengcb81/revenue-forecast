+def _bodies_for(connection: sqlite3.Connection, document_id: str) -> list[str]:
+    """The document's own normalized markdown, as candidate bodies."""
+    row = connection.execute(
+        "SELECT path FROM artifacts WHERE document_id=? AND artifact_role=? "
+        "AND generator_name=? AND status='completed' "
