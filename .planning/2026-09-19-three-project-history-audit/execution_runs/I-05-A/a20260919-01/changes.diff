+def _row_valid_alone(
+    connection: sqlite3.Connection,
+    row: sqlite3.Row,
+    bodies: list[str],
+    slice_roots: tuple[Path, ...],
+) -> bool:
+    """P3-4: is this row independently usable?  (index + window only)"""
+    entries, reason = _index_entries(row["path"], bodies=bodies, allowed_roots=slice_roots)
