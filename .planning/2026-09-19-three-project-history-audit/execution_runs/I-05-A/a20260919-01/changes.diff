+def _slice_hash_failure(entry: dict, body: bytes) -> str | None:
+    """Secondary check on the index's own recorded slice hash.
+
+    A1/P1-1: this hash lives INSIDE index.json, i.e. in the same file as
+    ``path``/``char_start``/``char_end``, and index.json is anchored only by
+    ``artifacts.content_sha256`` - so an attacker who rewrites the slice, the
+    index and the row hash together can make this check agree with itself.  It
+    stays as defence in depth; the BINDING is the source window below.
+    """
+    recorded = str(entry.get("content_sha256") or "")
+    if not recorded:
+        return None
+    if len(recorded) != 64:
+        return "sections_binding_error"
+    allowed = "0123456789abcdef"
+    if not all(char in allowed for char in recorded):
+        return "sections_binding_error"
+    if hashlib.sha256(body).hexdigest() != recorded:
+        return "sections_hash_mismatch"
+    return None
+
+
+def _fragment_in_bodies(fragment: str, bodies: list[str]) -> bool:
+    needle = fragment.strip("\n")
+    return bool(needle) and any(needle in body for body in bodies)
