+def _meta_of(meta: Any, row: sqlite3.Row) -> dict:
+    """Shape-check the ALREADY parsed shared metadata value.
+
+    Parsing stays at the ratcheted call site (``list_sections``); ``row`` is
+    passed only for the error message, so no second column access exists.
+    """
+    if not isinstance(meta, dict) or not isinstance(meta.get("sections"), list):
+        raise SectionQueryError(
+            f"sections artifact metadata is not valid JSON "
+            f"(artifact {row['artifact_id']})"
+        )
+    return meta
