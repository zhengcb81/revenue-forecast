+def _catalog_derived_paths(database_path: Path | str) -> tuple[Path, tuple[Path, ...]]:
+    """Allowed roots for this catalog, derived from the DATABASE location.
+
+    F-I05A-04: the first version took the root from the artifact path's own
+    ``parents[3]``, which made ``artifact_path_outside_allowed_root``
+    unreachable (a path is always inside a root computed from itself).  The
+    catalog directory is the parent of ``catalog.sqlite3``, so the roots are
+    known independently of the path being validated.
+    """
