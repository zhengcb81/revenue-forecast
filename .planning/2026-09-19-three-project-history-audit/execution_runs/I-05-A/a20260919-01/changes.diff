+def _frontmatter_body_start(text: str) -> int:
+    """Where the extractor's ``_strip_frontmatter`` leaves the body.
+
+    Mirrors ``section_extractor._strip_frontmatter``: a leading ``---`` block is
+    dropped up to and including the next newline-plus-``---``, and the remainder
+    starts at the character after it (usually a newline).
+    """
+    if text.startswith("---"):
+        end = text.find("\n---", 3)
+        if end != -1:
+            return end + 4
+    return 0
+
+
+def _candidate_bodies(text: str) -> list[str]:
+    """The plausible transformed texts the producer may have sliced.
+
+    The producer slices the body returned by ``_strip_frontmatter``; whether the
+    parser that wrote this markdown already dropped the ``# title`` line (a real
+    layout difference between parsers) decides what that body starts with.
+    Enumerating both forms anchors the check on the CONTENT rather than on
+    layout details, which is what makes it independent of the file LENGTH and
+    therefore able to catch a same-length rewrite (A1/P1-1).
+    """
+    body = text[_frontmatter_body_start(text):]
+    stripped = body.lstrip()
+    bodies = [body]
+    if stripped != body:
+        bodies.append(stripped)
+    first_line_end = stripped.find("\n")
+    if first_line_end != -1:
+        after_title = stripped[first_line_end + 1:].lstrip()
+        if after_title and after_title not in bodies:
+            bodies.append(after_title)
+    return bodies
+
+
+def _window_starts(body: str) -> list[int]:
+    """Every newline boundary in a body's header region (bounded).
+
+    The producer's body starts at a newline boundary at or before the first
+    section heading, so the enumeration has to reach a few positions past any
+    leading page marker - 10 was too few ("## Page 1\\n\\n" alone consumes the
+    page boundary plus the two blank-line boundaries).  The scan stops after
+    the first 64 boundaries, which bounds the work on a pathological body.
+    """
+    starts = [0]
+    for index, char in enumerate(body):
+        if char == "\n":
+            starts.append(index + 1)
+        if len(starts) >= 64:
+            break
+    return starts
+
+
+def _span_of(entry: dict) -> int | None:
+    try:
+        span = int(entry["char_end"]) - int(entry["char_start"])
+    except (KeyError, TypeError, ValueError):
+        return None
+    return span if span > 0 else None
+
