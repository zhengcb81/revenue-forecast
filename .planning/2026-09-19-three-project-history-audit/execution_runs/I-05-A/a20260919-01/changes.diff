+def _metadata_disagreement(metadata: dict, entries: list[dict]) -> bool:
+    """F-I05A-01: the artifact row's metadata must not contradict the index.
+
+    The index is hash-bound to the artifact row; ``artifacts.metadata_json`` is
+    not covered by that hash, so serving the metadata let a one-column UPDATE
+    steer the answer to another file.  P3-3: every key the index carries is
+    compared (role/title/ordinal/char range/path/pages/spans/slice hash), not
+    only the five needed to close the original attack.
+    """
+    declared = metadata.get("sections")
+    if not isinstance(declared, list):
+        return False
+    if len(declared) != len(entries):
+        return True
+    keys = (
+        "role", "title", "ordinal", "char_start", "char_end", "path",
+        "page_start", "page_end", "span_ids", "content_sha256",
+    )
+    for metadata_entry, index_entry in zip(declared, entries):
+        if not isinstance(metadata_entry, dict):
+            return True
+        for key in keys:
+            if metadata_entry.get(key) != index_entry.get(key):
+                return True
+    return False
