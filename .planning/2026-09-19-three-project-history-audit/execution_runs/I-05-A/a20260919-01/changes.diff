+def _inside_roots(path: Path, allowed_roots: tuple[Path, ...]) -> bool:
+    """Containment gate, evaluated BEFORE any read (P3-2: no existence oracle)."""
+    resolved = path.resolve(strict=False)
+    for root in allowed_roots:
+        base = root.resolve(strict=False)
+        if resolved == base or base in resolved.parents:
+            return True
+    return False
