+def _window_matches(fragment: str, bodies: list[str], char_start: int) -> int | None:
+    """The offset where the fragment IS the window at ``char_start``, else None.
+
+    The index records CHARACTER offsets in the producer's body coordinate
+    system; the body here is the same text prefixed by an unknown, small number
+    of header characters (frontmatter / title / leading newlines).  Rather than
+    guessing that prefix, this locates the fragment in the header region and
+    then verifies it also occurs ``char_start`` characters later - i.e. that the
+    slice really is the text at the offset the index claims.
+
+    Trim semantics are the frozen r1 ones (oracle.md §3.1.1):
+    ``fragment.strip("\\n") == window.strip("\\n")``.
+    """
+    needle = fragment.strip("\n")
+    if not needle:
+        return False
+    for body in bodies:
+        found = body.find(needle)
+        if found == -1:
+            continue
+        for offset in _window_starts(body):
+            start = found + char_start - offset
+            if start < 0 or start + len(fragment) > len(body):
+                continue
+            if body[start:start + len(fragment)].strip("\n") == needle:
+                return start
+    return None
+
+
+def _window_label(
+    offsets: list[int], bodies: list[str], fragment: bytes
+) -> str:
+    """How the served slice is bound to the source (A1/P1-1 reporting)."""
+    if offsets:
+        return "source_window"
+    if not bodies or not fragment:
+        return "no_source"
+    try:
+        text = fragment.decode("utf-8")
+    except UnicodeDecodeError:
+        return "no_source"
+    return "substring_only" if _fragment_in_bodies(text, bodies) else "no_source"
+
+
+def _fragment_text(path: Any) -> str | None:
+    """The slice's text, or None when it cannot be read as UTF-8."""
+    try:
+        return Path(str(path or "")).read_bytes().decode("utf-8")
+    except (OSError, UnicodeError):
+        return None
+
+
+def _entry_view(entry: dict, bodies: list[str]) -> tuple[list[int], str]:
+    """(the matched boundary offset, binding label) for one index entry."""
+    char_start = int(entry.get("char_start") or 0)
+    text = _fragment_text(entry.get("path"))
+    if not bodies or text is None:
+        return [], "no_source"
+    start = _window_matches(text, bodies, char_start)
+    if start is not None:
+        return [start], "source_window"
+    return [], _window_label([], bodies, text.encode("utf-8"))
+
+
+def _to_entries(entries: list[dict], bodies: list[str]) -> tuple[SectionEntry, ...]:
+    """The served entries; built from the HASHED index, never from metadata."""
+    result = []
+    for entry in entries:
+        offsets, window_match = _entry_view(entry, bodies)
+        result.append(
+            SectionEntry(
+                role=entry["role"],
+                title=entry["title"],
+                ordinal=entry["ordinal"],
+                char_start=entry["char_start"],
+                char_end=entry["char_end"],
+                path=entry["path"],
+                page_start=entry.get("page_start"),
+                page_end=entry.get("page_end"),
+                span_ids=tuple(entry.get("span_ids") or ()),
+                content_sha256=entry.get("content_sha256"),
+                window_match=window_match,
+                window_positions=tuple(offsets),
+            )
+        )
+    return tuple(result)
+
