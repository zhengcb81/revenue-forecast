+        self.assertEqual(klass, "G4")
+
+    # -- T-L10 (R-LAYER-1) -------------------------------------------------
+    def test_tl10_a_new_signature_never_upgrades_the_capture_layer(self) -> None:
+        """A publication signature must not claim the raw capture was signed.
+
+        The unsigned L1 capture receipt is part of the artifact BEFORE it is signed,
+        so the record commits to it and the assertion is about CONTENT: nothing in
+        the artifact asserts that the capture was signed, and the L1
+        ``signature_present`` flag stays false.
+        """
+        _record, artifact = self._record_and_artifact()
+        # the L1 capture receipt of the SAME artifact is unsigned, and it was in the
+        # signed projection all along (see _record_and_artifact)
+        artifact["sources"] = [
+            {
+                "source_id": "s1",
+                "capture": {
+                    "host_receipt": {"issuer": "fixture-host", "signature_present": False}
+                },
+            }
+        ]
+        # attaching the unsigned capture INVALIDATES the commitment: that is the
+        # intended behaviour, and it is asserted rather than side-stepped
+        self.assertEqual(
+            ap.verify_publication_attestation(artifact),
+            [ap.E16_ATTESTATION_PAYLOAD_HASH_MISMATCH],
+        )
+        receipt = artifact["sources"][0]["capture"]["host_receipt"]
+        self.assertFalse(receipt["signature_present"])
+        self.assertNotIn("signature", receipt)
+        # the artifact must carry no field asserting the capture was signed
+        encoded = json.dumps(artifact)
+        self.assertFalse(
+            any(
+                token in encoded
+                for token in ("capture_signed", "source_signed", "raw_signed")
+            )
+        )
+
+    def test_tl10b_unsigned_capture_inside_the_signed_projection_still_verifies(
+        self,
+    ) -> None:
+        """R-LAYER-1: signing the publication does not sign the capture, and the
+        artifact still verifies when the capture is part of the signed content."""
+        self._install_signer()
+        input_sha256 = hashlib.sha256(b"input").hexdigest()
+        artifact = {
+            "schema_version": "3.7",
+            "forecast_schema_version": "3.7",
+            "publication_receipt": {
+                "attestation_status": "host_signed",
+                "schema_version": "3.7",
+            },
+            "sources": [
+                {
+                    "source_id": "s1",
+                    "capture": {
+                        "host_receipt": {
+                            "issuer": "fixture-host",
+                            "signature_present": False,
+                        }
+                    },
+                }
+            ],
+            "input_sha256": input_sha256,
+        }
+        outcome = ap.attest_publication(
+            payload_sha256=ap.payload_sha256(artifact),
+            input_sha256=input_sha256,
+            result_sha256="",
+            receipt_sha256="",
+            gate_ids=("output_recomputation",),
+            requested_issuer=ISSUER,
+        )
+        assert outcome.record is not None
+        artifact["publication_attestation"] = outcome.record
+        artifact["payload_sha256"] = outcome.record["payload_sha256"]
+        self.assertEqual(ap.verify_publication_attestation(artifact), [])
+        capture = artifact["sources"][0]["capture"]["host_receipt"]
+        self.assertFalse(capture["signature_present"])
+        self.assertNotIn("signature", capture)
+
+    def test_tl11_l2_signed_receipt_does_not_make_a_publication_host_signed(self) -> None:
+        """R-LAYER-2: L1/L2 signatures are never sufficient for host_signed."""
+        self._install_signer()
+        artifact = self._bare("3.7", "unattested")
+        artifact["sources"] = [
+            {
+                "source_id": "s1",
+                "capture": {
+                    "host_receipt": {
+                        "issuer": ISSUER,
+                        "signature": "a" * 128,
+                        "public_key_fingerprint": "b" * 32,
+                    }
+                },
+            }
+        ]
+        klass, _ = classify(artifact)
+        self.assertEqual(klass, "G3a")
+        self.assertEqual(
+            artifact["publication_receipt"]["attestation_status"], "unattested"
+        )
+
