+"""I-08-B legacy classification: G1 / G2 / G3a / G3b -> G4 (T-L1..T-L11).
+
+``decision.md`` section 6.1 freezes ONE judgement function.  The judgement key is
+"did the artifact make a signing claim", never "is the version different from the
+current one" -- the latter is exactly the predicate R-LEGACY-1 forbids, because it
+would hand the opt-in 3.8 schema the same blanket bypass as a 3.0 artifact.
+
+It also covers two codes that the independent review found to be declared but
+unreachable, and now asserts them against the gates that actually raise them:
+
+* **E30** ``input_binding_mismatch`` at ``trust_anchor.verify_input_binding``;
+* **E29** ``legacy_exemption_not_allowed_for_optin_schema`` at
+  ``require_legacy_exemption``.
+"""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import os
+import sys
+import tempfile
+import unittest
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))
+
+import attestation_protocol as ap  # noqa: E402
+from attestation_protocol import (  # noqa: E402
+    AttestationError,
+    classify,
+    is_legacy_exempt,
+    load_trust_domain,
+    require_class_permits,
+    verify_publication_attestation,
+)
+
+FAKE_PROVIDER = Path(__file__).resolve().parent / "e2e_support" / "i08b_fake_provider.py"
+ISSUER = "revenue-forecast/host-a"
+G1_VERSIONS = ("3.0", "3.1", "3.2", "3.3", "3.4", "3.5", "3.6")
+
+
+def _rfc3339(moment: datetime) -> str:
+    return moment.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+class LegacyClassificationTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self._env: dict[str, str | None] = {}
+        for name in (
+            ap.PROVIDER_ENV_VAR,
+            ap.PROVIDER_ARGV_ENV_VAR,
+            ap.TRUST_DOMAIN_ENV_VAR,
+            ap.TIMEOUT_ENV_VAR,
+            ap.STDOUT_LIMIT_ENV_VAR,
+            ap.MAX_WINDOW_ENV_VAR,
+            "I08B_FAKE_KEY_HEX",
+            "I08B_FAKE_MODE",
+            "I08B_FAKE_ISSUER",
+            "I08B_FAKE_KEY_ID",
+            "I08B_FAKE_SIGNED_AT",
+            "I08B_FAKE_LOG",
+        ):
+            self._env[name] = os.environ.get(name)
+            os.environ.pop(name, None)
+        self._temporary = tempfile.TemporaryDirectory()
+        self.tmp = Path(self._temporary.name)
+        os.environ[ap.TIMEOUT_ENV_VAR] = "20"
+        os.environ[ap.STDOUT_LIMIT_ENV_VAR] = "65536"
+        os.environ[ap.MAX_WINDOW_ENV_VAR] = "3600"
+
+    def tearDown(self) -> None:
+        for name, value in self._env.items():
+            os.environ.pop(name, None)
+            if value is not None:
+                os.environ[name] = value
+        self._temporary.cleanup()
+
+    # -- helpers -----------------------------------------------------------
+    def _install_signer(self) -> None:
+        from cryptography.hazmat.primitives import serialization
+        from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
+
+        private_key = Ed25519PrivateKey.generate()
+        public_bytes = private_key.public_key().public_bytes(
+            encoding=serialization.Encoding.Raw,
+            format=serialization.PublicFormat.Raw,
+        )
+        fingerprint = hashlib.sha256(public_bytes).hexdigest()[:32]
+        now = datetime.now(timezone.utc)
+        domain = {
+            "trust_domain_schema_version": "1.0",
+            "domain_separator": ap.DOMAIN_SEPARATOR,
+            "public_keys": [
+                {
+                    "name": "i08b-legacy-signer",
+                    "public_key": base64.b64encode(public_bytes).decode("ascii"),
+                    "fingerprint": fingerprint,
+                    "issuer": ISSUER,
+                    "key_id": "i08b-legacy-key",
+                    "algorithm": "ed25519",
+                    "environment": "production",
+                    "not_before": _rfc3339(now - timedelta(days=1)),
+                    "not_after": _rfc3339(now + timedelta(days=1)),
+                    "status": "active",
+                    "revoked_at": None,
+                }
+            ],
+        }
+        path = self.tmp / "trust_domain.json"
+        path.write_text(json.dumps(domain), encoding="utf-8")
+        os.environ[ap.TRUST_DOMAIN_ENV_VAR] = str(path)
+        os.environ[ap.PROVIDER_ENV_VAR] = sys.executable
+        os.environ[ap.PROVIDER_ARGV_ENV_VAR] = json.dumps([str(FAKE_PROVIDER)])
+        os.environ["I08B_FAKE_KEY_HEX"] = private_key.private_bytes(
+            encoding=serialization.Encoding.Raw,
+            format=serialization.PrivateFormat.Raw,
+            encryption_algorithm=serialization.NoEncryption(),
+        ).hex()
+        os.environ["I08B_FAKE_ISSUER"] = ISSUER
+        os.environ["I08B_FAKE_KEY_ID"] = "i08b-legacy-key"
+        os.environ["I08B_FAKE_MODE"] = "ok"
+        os.environ["I08B_FAKE_SIGNED_AT"] = "+1"
+
+    def _record_and_artifact(self, version: str = "3.7", status: str = "host_signed"):
+        """Build an artifact whose record commits to THAT artifact's projection.
+
+        The whole artifact base — including ``forecast_schema_version``, which is
+        INSIDE the projection — is assembled first, hashed, and only then signed.
+        ``payload_sha256`` is the artifact's statement of that commitment and is
+        excluded from the projection, so it can be attached after signing (exactly
+        as ``run_forecast`` does).
+        """
+        self._install_signer()
+        input_sha256 = hashlib.sha256(b"input").hexdigest()
+        artifact = {
+            "schema_version": version,
+            "forecast_schema_version": version,
+            "publication_receipt": {
+                "attestation_status": status,
+                "schema_version": version,
+            },
+            "sources": [],
+            # every key that is inside the projection must be present BEFORE the
+            # commitment is computed, otherwise attaching it afterwards (correctly)
+            # invalidates the commitment
+            "input_sha256": input_sha256,
+        }
+        outcome = ap.attest_publication(
+            payload_sha256=ap.payload_sha256(artifact),
+            input_sha256=input_sha256,
+            result_sha256="",
+            receipt_sha256="",
+            gate_ids=("output_recomputation",),
+            requested_issuer=ISSUER,
+        )
+        self.assertEqual(outcome.status, "host_signed", outcome.detail)
+        record = outcome.record
+        assert record is not None
+        artifact["publication_attestation"] = record
+        artifact["payload_sha256"] = record["payload_sha256"]
+        self.assertEqual(ap.payload_sha256(artifact), record["payload_sha256"])
+        return record, artifact
+
+    @staticmethod
+    def _bare(version: str, status: str | None) -> dict:
+        receipt: dict = {"schema_version": version}
+        if status is not None:
+            receipt["attestation_status"] = status
+        return {"schema_version": version, "publication_receipt": receipt}
+
+    def assert_code(self, expected: str, callable_, *args, **kwargs):
+        with self.assertRaises(AttestationError) as ctx:
+            callable_(*args, **kwargs)
+        self.assertEqual(
+            ctx.exception.code,
+            expected,
+            f"expected {expected}, got {ctx.exception.code} ({ctx.exception})",
+        )
+        return ctx.exception
+
+    # -- T-L1 / T-L9 -------------------------------------------------------
+    def test_tl1_signed_artifact_is_g2_and_verifies(self) -> None:
+        record, artifact = self._record_and_artifact()
+        self.assertEqual(verify_publication_attestation(artifact), [])
+        klass, code = classify(artifact)
+        self.assertEqual((klass, code), ("G2", None))
+
+    def test_tl9_tampered_record_is_g4(self) -> None:
+        record, artifact = self._record_and_artifact()
+        artifact["publication_attestation"] = {**record, "key_id": "forged"}
+        klass, code = classify(artifact)
+        self.assertEqual(klass, "G4")
+        self.assertEqual(code, ap.E14_ATTESTATION_SIGNATURE_INVALID)
+        self.assert_code(
+            ap.E14_ATTESTATION_SIGNATURE_INVALID, require_class_permits, artifact,
+            require_attestation=True,
+        )
+
+    def test_tl5b_artifact_payload_hash_mismatch_is_g4(self) -> None:
+        record, artifact = self._record_and_artifact()
+        artifact["payload_sha256"] = "0" * 64
+        klass, code = classify(artifact)
+        self.assertEqual((klass, code), ("G4", ap.E16_ATTESTATION_PAYLOAD_HASH_MISMATCH))
+
+    # -- T-L2 / T-L3 / T-L4 (G3b -> G4, G3a preserved) ---------------------
+    def test_tl2_claims_host_signed_without_a_record_is_g4(self) -> None:
+        artifact = self._bare("3.7", "host_signed")
+        klass, code = classify(artifact)
+        self.assertEqual((klass, code), ("G4", ap.E27_ATTESTATION_MISSING_RECORD))
+        # never silently downgraded to unattested:
+        self.assert_code(
+            ap.E27_ATTESTATION_MISSING_RECORD, require_class_permits, artifact,
+            require_attestation=False,
+        )
+
+    def test_tl3_unattested_current_schema_is_g3a(self) -> None:
+        artifact = self._bare("3.7", "unattested")
+        klass, code = classify(artifact)
+        self.assertEqual((klass, code), ("G3a", ap.E26_ATTESTATION_ABSENT))
+        # preserved for reading, refused by a gate that requires an attestation
+        self.assertEqual(require_class_permits(artifact, require_attestation=False), "G3a")
+        self.assert_code(
+            ap.E26_ATTESTATION_ABSENT, require_class_permits, artifact,
+            require_attestation=True,
+        )
+
+    def test_tl4_missing_status_is_g3a(self) -> None:
+        artifact = self._bare("3.7", None)
+        self.assertEqual(classify(artifact), ("G3a", ap.E26_ATTESTATION_ABSENT))
+
+    # -- T-L5 / T-L6 / T-L7 / T-L8 ----------------------------------------
+    def test_tl5_every_g1_version_is_read_only(self) -> None:
+        for version in G1_VERSIONS:
+            with self.subTest(version=version):
+                artifact = self._bare(version, None)
+                klass, code = classify(artifact)
+                self.assertEqual((klass, code), ("G1", ap.E28_LEGACY_READ_ONLY))
+                self.assertEqual(
+                    require_class_permits(artifact, require_attestation=False), "G1"
+                )
+                # a G1 artifact may not pass a gate that requires an attestation
+                self.assert_code(
+                    ap.E28_LEGACY_READ_ONLY, require_class_permits, artifact,
+                    require_attestation=True,
+                )
+
+    def test_tl6_optin_3_8_without_a_claim_is_g3a(self) -> None:
+        artifact = self._bare("3.8", "unattested")
+        self.assertEqual(classify(artifact), ("G3a", ap.E26_ATTESTATION_ABSENT))
+
+    def test_tl7_3_8_gets_no_automatic_g1_exemption(self) -> None:
+        self.assertFalse(is_legacy_exempt("3.8"))
+        for version in G1_VERSIONS:
+            self.assertTrue(is_legacy_exempt(version), version)
+        self.assertFalse(is_legacy_exempt("3.7"))
+        self.assertFalse(is_legacy_exempt(None))
+        # a 3.8 artifact that claims host_signed without a record is G4, not G1
+        artifact = self._bare("3.8", "host_signed")
+        self.assertEqual(
+            classify(artifact), ("G4", ap.E27_ATTESTATION_MISSING_RECORD)
+        )
+
+    def test_tl7b_licensed_exemption_entry_point_raises_e29(self) -> None:
+        """E29 must be REACHABLE, not merely declared.
+
+        A predicate can only answer "no"; it cannot REPORT that an exemption was
+        wrongly claimed.  ``require_legacy_exemption`` is the reportable half and is
+        the entry point a consumer is supposed to call.
+        """
+        for version in G1_VERSIONS:
+            self.assertTrue(ap.require_legacy_exemption(version), version)
+        for forbidden in ("3.7", "3.8", "9.9", None):
+            with self.subTest(version=forbidden):
+                self.assert_code(
+                    ap.E29_LEGACY_EXEMPTION_NOT_ALLOWED_FOR_OPTIN_SCHEMA,
+                    ap.require_legacy_exemption,
+                    forbidden,
+                )
+        error = self.assert_code(
+            ap.E29_LEGACY_EXEMPTION_NOT_ALLOWED_FOR_OPTIN_SCHEMA,
+            ap.require_legacy_exemption,
+            "3.8",
+        )
+        self.assertIn("3.8", str(error))
