+    def test_t_o1_handshake_succeeds_against_isolated_domain(self) -> None:
+        self.install_valid_domain()
+        self.use_fake_provider()
+        request = self.make_request()
+        baseline = self.provider_calls()
+        result = self.raw_call(request)
+        self.assertTrue(result.ok, result.detail)
+        self.assertEqual(result.returncode, 0)
+        self.assertEqual(self.provider_calls(), baseline + 1)
+        response = ap.validate_response(result.response, request)
+        self.assertEqual(set(response), set(RESPONSE_FIELDS))
+        for field in ap.ECHO_FIELDS:
+            self.assertEqual(response[field], request[field])
+
+        record = self.signed_record(request)
+        self.assertEqual(set(record), set(ATTESTATION_RECORD_FIELDS))
+        self.assertEqual(record["signature_algorithm"], "ed25519")
+        self.assertEqual(record["payload_sha256"], request["payload_sha256"])
+        self.assertEqual(record["gate_ids"], list(request["gate_ids"]))
+        verify_attestation_record(record, domain=load_trust_domain())
+        self.assertEqual(self.provider_calls(), baseline + 2)
