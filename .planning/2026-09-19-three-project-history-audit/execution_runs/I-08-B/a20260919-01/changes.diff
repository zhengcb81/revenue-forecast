+        result = run_forecast(forecast_document())
+        outcome = result["publication_attestation_outcome"]
+        self.assertEqual(
+            result["publication_receipt"]["attestation_status"],
+            "host_signed",
+            f"the real funnel did not sign: code={outcome['failure_code']} "
+            f"detail={outcome['detail']}",
+        )
+        return result
+
+    def assert_code(self, expected: str, callable_, *args, **kwargs) -> AttestationError:
+        with self.assertRaises(AttestationError) as ctx:
+            callable_(*args, **kwargs)
+        self.assertEqual(
+            ctx.exception.code,
+            expected,
+            f"expected {expected}, got {ctx.exception.code} ({ctx.exception})",
+        )
+        return ctx.exception
+
