+        )
+
+    def raw_sides(self, request: dict | None = None) -> tuple[dict, dict, dict]:
+        """One real handshake: (request, response, payload) without any judgement."""
+        request = request or self.make_request()
+        result = self.raw_call(request)
+        self.assertTrue(
+            result.ok, f"provider call failed: {result.code} {result.detail}"
+        )
+        response = ap.validate_response(result.response, request)
+        payload = ap.response_to_payload(
+            response, request, gate_ids=tuple(request["gate_ids"])
+        )
+        return request, response, payload
+
+    def signed_sides(self, request: dict | None = None) -> tuple[dict, dict, dict, dict]:
+        """Same handshake, but requiring that the trust-domain tuple also verifies."""
+        request, response, payload = self.raw_sides(request)
+        domain = load_trust_domain()
+        ap.verify_signed_payload(payload, response["signature"], domain)
+        return request, response, payload, domain
+
+    def record_from(self, payload: dict, signature: str, *, verify: bool = True) -> dict:
+        """Build the official record through the design's own builder.
+
+        The signed payload keeps the design's payload vocabulary
+        (``algorithm`` / ``attestation_payload_schema_version``); only the wire
+        RESPONSE uses ``signature_algorithm``.  The adapter below is the same one
+        production applies when it turns a response into a record, so the harness
+        can never invent a record shape of its own.
+        """
+        request = ap.build_request(
+            request_id=payload["request_id"],
+            issued_at=payload["issued_at"],
+            expires_at=payload["expires_at"],
+            payload_sha256=payload["payload_sha256"],
+            input_sha256=payload["input_sha256"],
+            result_sha256=payload["result_sha256"],
+            receipt_sha256=payload["receipt_sha256"],
+            requested_issuer=payload["issuer"],
+            gate_ids=tuple(payload["gate_ids"]),
+            domain_separator=payload["domain_separator"],
+        )
+        response = {
+            "attestation_response_schema_version": "1.0",
+            "request_id": payload["request_id"],
+            "payload_sha256": payload["payload_sha256"],
+            "domain_separator": payload["domain_separator"],
+            "issuer": payload["issuer"],
+            "key_id": payload["key_id"],
+            "key_fingerprint": payload["key_fingerprint"],
+            "signature_algorithm": payload["algorithm"],
+            "signature": signature,
+            "signed_at": payload["signed_at"],
+        }
+        return ap.build_attestation_record(
+            response,
+            request,
+            gate_ids=tuple(payload["gate_ids"]),
+            w_enforced=self._w_enforced(),
+            domain=load_trust_domain(),
+            verify=verify,
+        )
+
+    def constructed_record(self, **entry_overrides) -> dict:
+        """A structurally valid, correctly signed record whose KEY would be rejected.
+
+        Used by the trust-domain negative cases: the builder must not refuse to
+        construct what the verifier is supposed to reject.
+        """
+        self.install_valid_domain(**entry_overrides)
+        self.use_fake_provider()
+        _, response, payload = self.raw_sides()
+        return self.record_from(payload, response["signature"], verify=False)
+
+    def _w_enforced(self) -> bool:
+        return ap.max_window_seconds() is not None
+
+    def signed_record(
+        self, request: dict | None = None, signed_at_offset: int | None = None
+    ) -> dict:
+        """One handshake + a verified record; the stamp is issued_at + offset."""
+        request = request or self.make_request()
+        if signed_at_offset is not None:
+            os.environ["I08B_FAKE_SIGNED_AT"] = str(signed_at_offset)
+        if not os.environ.get(ap.PROVIDER_ENV_VAR):
+            self.use_fake_provider()
+        _, response, payload, _ = self.signed_sides(request)
+        return self.record_from(payload, response["signature"])
+
+    def sign_one(self) -> tuple[dict, dict]:
+        self.install_valid_domain()
+        self.use_fake_provider()
+        request = self.make_request()
+        return request, self.signed_record(request)
+
+    def sign_payload(self, payload: dict) -> str:
+        return self.private_key.sign(ap.signed_message(payload)).hex()
+
+    def re_record(self, record: dict, changes: dict) -> dict:
+        """Apply *changes* to the signed payload, re-sign, rebuild the record.
+
+        The record is assembled with the protocol's own field layout but WITHOUT
+        re-judging the payload: a case must be able to build the exact artefact it
+        wants the verifier to reject (a stamp outside the window, another issuer,
+        another domain) and then assert on the verifier, not on the builder.
+        """
+        payload = ap.record_to_payload(record)
+        payload.update(changes)
+        return {
+            "attestation_record_schema_version": payload[
+                "attestation_payload_schema_version"
+            ],
+            **{
+                key: value
+                for key, value in payload.items()
+                if key not in ("algorithm", "attestation_payload_schema_version")
+            },
+            "signature_algorithm": payload["algorithm"],
+            "signature": self.sign_payload(payload),
+            "W_enforced": record["W_enforced"],
+        }
+
+    def real_signed_artifact(self, *, domain_days: int = 100) -> dict:
+        """A REAL signed publication: the production funnel does the handshake.
+
+        The trust domain is re-written with wide validity bounds first, because the
+        production funnel runs on the live wall clock while this harness's anchors
+        are fixed: the point of the case is the re-verification behaviour, not the
+        key-window arithmetic (which has its own anchored cases).
