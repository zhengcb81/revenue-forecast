+# ---------------------------------------------------------------------------
+# 3. Small parsing helpers
+# ---------------------------------------------------------------------------
+
+
+def parse_utc(value: Any, field: str, code: str = E15_ATTESTATION_PAYLOAD_FIELDS) -> datetime:
+    """Parse a strict RFC3339 UTC ``Z`` timestamp or raise *code*."""
+    if not isinstance(value, str) or _RFC3339_Z.fullmatch(value) is None:
+        raise AttestationError(code, f"{field} must be an RFC3339 UTC 'Z' timestamp")
+    try:
+        return datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(
+            tzinfo=timezone.utc
+        )
+    except ValueError as exc:  # pragma: no cover - regex already constrains shape
+        raise AttestationError(code, f"{field} is not a valid timestamp") from exc
+
+
+def rfc3339_z(moment: datetime) -> str:
+    """Render a timezone-aware datetime as RFC3339 UTC ``Z`` (second precision)."""
+    return moment.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def canonical_text(value: Any) -> Any:
+    """NFC-normalise every string in *value* (decision.md section 4.1).
+
+    Homoglyph/duplicate-codepoint tricks must not be able to produce two
+    different byte strings for one logical payload.
+    """
+    if isinstance(value, str):
+        return unicodedata.normalize("NFC", value)
+    if isinstance(value, list):
+        return [canonical_text(item) for item in value]
+    if isinstance(value, dict):
+        return {key: canonical_text(item) for key, item in value.items()}
+    return value
+
+
+def canonical_bytes(value: Any) -> bytes:
+    """The exact bytes that are signed: canonical JSON, UTF-8, NFC strings."""
+    return json.dumps(
+        canonical_text(value),
+        ensure_ascii=False,
+        sort_keys=True,
+        separators=(",", ":"),
+        allow_nan=False,
+    ).encode("utf-8")
+
+
+def signed_message(payload: Any) -> bytes:
+    """``canonical_sha256(payload)`` as 64 ASCII hex characters."""
+    return hashlib.sha256(canonical_bytes(payload)).hexdigest().encode("ascii")
+
+
+def fingerprint_of(public_key_bytes: bytes) -> str:
+    """sha256(raw public key) first 32 hex characters (existing repo format)."""
+    return hashlib.sha256(public_key_bytes).hexdigest()[:32]
+
+
+def _require_hex64(value: Any, field: str) -> str:
+    if not isinstance(value, str) or _HEX64.fullmatch(value) is None:
+        raise AttestationError(
+            E15_ATTESTATION_PAYLOAD_FIELDS, f"{field} must be 64 lowercase hex"
+        )
+    return value
+
+
+def _require_text(value: Any, field: str) -> str:
+    if not isinstance(value, str) or not value.strip():
+        raise AttestationError(
+            E15_ATTESTATION_PAYLOAD_FIELDS, f"{field} must be a non-empty string"
+        )
+    return value
+
+
+def _require_exact_fields(
+    value: Any, expected: tuple[str, ...], code: str, what: str
+) -> dict[str, Any]:
+    if not isinstance(value, dict):
+        raise AttestationError(code, f"{what} must be an object")
+    if set(value) != set(expected):
+        missing = sorted(set(expected) - set(value))
+        extra = sorted(set(value) - set(expected))
+        raise AttestationError(
+            code, f"{what} field set mismatch (missing={missing} extra={extra})"
+        )
+    return value
+
+
+# ---------------------------------------------------------------------------
+# 4. Trust domain (data file, never a code constant)
+# ---------------------------------------------------------------------------
+
+
+def trust_domain_path() -> Path:
+    """The trust-domain file: env override, else the repo default path."""
+    override = os.environ.get(TRUST_DOMAIN_ENV_VAR)
+    if override:
+        return Path(override).expanduser()
+    # scripts/attestation_protocol.py -> repo root is parents[1]; when this file
+    # is imported as ``contracts.attestation_protocol`` the repo root is
+    # parents[2].  Anchor on the directory that actually holds ``config``.
+    here = Path(__file__).resolve()
+    for candidate in (here.parents[1], here.parents[2]):
+        if (candidate / "scripts").is_dir():
+            return candidate / "config" / "trusted_signer_public_keys.json"
+    return here.parents[1] / "config" / "trusted_signer_public_keys.json"
+
+
+def parse_trust_domain_entry(raw: Any) -> dict[str, Any]:
+    """Validate one trust-domain entry against the closed named field set.
+
+    Any violation raises :data:`E25_TRUST_DOMAIN_SCHEMA_ERROR`.  Unknown fields
+    are rejected rather than ignored: silently ignoring a field means "the trust
+    domain was edited but the change did not take effect".
+    """
+    if not isinstance(raw, dict):
+        raise AttestationError(E25_TRUST_DOMAIN_SCHEMA_ERROR, "entry must be an object")
+    unknown = sorted(set(raw) - TRUST_DOMAIN_ENTRY_FIELDS)
+    if unknown:
+        raise AttestationError(
+            E25_TRUST_DOMAIN_SCHEMA_ERROR, f"unknown entry field(s): {unknown}"
+        )
+    missing = sorted(set(TRUST_DOMAIN_ENTRY_REQUIRED) - set(raw))
+    if missing:
+        raise AttestationError(
+            E25_TRUST_DOMAIN_SCHEMA_ERROR, f"missing entry field(s): {missing}"
+        )
+    if raw.get("name") is not None and not isinstance(raw["name"], str):
+        raise AttestationError(E25_TRUST_DOMAIN_SCHEMA_ERROR, "name must be a string")
+
+    public_key_raw = raw["public_key"]
+    if not isinstance(public_key_raw, str):
+        raise AttestationError(
+            E25_TRUST_DOMAIN_SCHEMA_ERROR, "public_key must be base64 text"
+        )
+    try:
+        public_key = base64.b64decode(public_key_raw, validate=True)
+    except (binascii.Error, ValueError) as exc:
+        raise AttestationError(
+            E25_TRUST_DOMAIN_SCHEMA_ERROR, "public_key is not valid base64"
+        ) from exc
+    if len(public_key) != 32:
+        raise AttestationError(
+            E25_TRUST_DOMAIN_SCHEMA_ERROR,
+            f"public_key must be 32 raw bytes, got {len(public_key)}",
+        )
+
+    fingerprint = raw["fingerprint"]
+    if not isinstance(fingerprint, str) or _HEX32.fullmatch(fingerprint) is None:
+        raise AttestationError(
+            E25_TRUST_DOMAIN_SCHEMA_ERROR, "fingerprint must be 32 lowercase hex"
+        )
+    if fingerprint != fingerprint_of(public_key):
+        raise AttestationError(
+            E25_TRUST_DOMAIN_SCHEMA_ERROR,
+            "fingerprint does not match sha256(public_key)[:32]",
+        )
+
+    for field in ("issuer", "key_id", "environment"):
+        if not isinstance(raw[field], str) or not raw[field].strip():
+            raise AttestationError(
+                E25_TRUST_DOMAIN_SCHEMA_ERROR, f"{field} must be a non-empty string"
+            )
+    if raw["algorithm"] != SIGNATURE_ALGORITHM:
+        raise AttestationError(
+            E25_TRUST_DOMAIN_SCHEMA_ERROR, "algorithm must be ed25519"
+        )
+
+    status = raw["status"]
+    if status not in STATUSES:
+        raise AttestationError(
+            E25_TRUST_DOMAIN_SCHEMA_ERROR, "status must be 'active' or 'revoked'"
+        )
+    not_before = parse_utc(
+        raw["not_before"], "not_before", E25_TRUST_DOMAIN_SCHEMA_ERROR
+    )
+    not_after = parse_utc(raw["not_after"], "not_after", E25_TRUST_DOMAIN_SCHEMA_ERROR)
+    revoked_at_raw = raw["revoked_at"]
+    if status == "active":
+        if revoked_at_raw is not None:
+            raise AttestationError(
+                E25_TRUST_DOMAIN_SCHEMA_ERROR,
+                "an active entry must carry revoked_at = null",
+            )
+        if not not_after > not_before:
+            raise AttestationError(
+                E25_TRUST_DOMAIN_SCHEMA_ERROR, "active entry requires not_after > not_before"
+            )
+        revoked_at = None
+    else:
+        revoked_at = parse_utc(
+            revoked_at_raw, "revoked_at", E25_TRUST_DOMAIN_SCHEMA_ERROR
+        )
+        if revoked_at < not_before:
+            raise AttestationError(
+                E25_TRUST_DOMAIN_SCHEMA_ERROR, "revoked_at must be >= not_before"
+            )
+
+    return {
+        "name": raw.get("name"),
+        "public_key": public_key,
+        "fingerprint": fingerprint,
+        "issuer": raw["issuer"],
+        "key_id": raw["key_id"],
+        "algorithm": raw["algorithm"],
+        "environment": raw["environment"],
+        "not_before": not_before,
+        "not_after": not_after,
+        "status": status,
+        "revoked_at": revoked_at,
+    }
+
+
+def load_trust_domain(path: Path | None = None) -> dict[str, dict[str, Any]]:
+    """Load the trust domain keyed by fingerprint.
+
+    Loading semantics (fail loud, not silently empty):
+
+    * file absent -> ``{}`` is a LEGAL "zero trusted signers" (fail closed);
+    * file present but not parseable / wrong key name / bad entry -> **E25**, and
+      the caller must abort.  Configuration damage must never be
+      indistinguishable from "nothing configured".
+    """
+    target = path if path is not None else trust_domain_path()
+    if not target.exists():
+        return {}
+    try:
+        text = target.read_text(encoding="utf-8")
+    except OSError as exc:
+        raise AttestationError(
+            E25_TRUST_DOMAIN_SCHEMA_ERROR, f"trust domain unreadable: {exc}"
+        ) from exc
+    try:
+        data = json.loads(text)
+    except ValueError as exc:
+        raise AttestationError(
+            E25_TRUST_DOMAIN_SCHEMA_ERROR, f"trust domain is not valid JSON: {exc}"
+        ) from exc
+    if not isinstance(data, dict):
+        raise AttestationError(
+            E25_TRUST_DOMAIN_SCHEMA_ERROR, "trust domain must be a JSON object"
+        )
+    unknown = sorted(set(data) - TRUST_DOMAIN_TOP_LEVEL_FIELDS)
+    if unknown:
+        raise AttestationError(
+            E25_TRUST_DOMAIN_SCHEMA_ERROR,
+            f"unknown top-level key(s): {unknown} (expected 'public_keys')",
+        )
+    if "public_keys" not in data:
+        raise AttestationError(
+            E25_TRUST_DOMAIN_SCHEMA_ERROR,
+            "top-level key 'public_keys' is required",
+        )
+    if data.get("trust_domain_schema_version") != TRUST_DOMAIN_SCHEMA_VERSION:
+        raise AttestationError(
+            E25_TRUST_DOMAIN_SCHEMA_ERROR, "unsupported trust domain schema version"
+        )
+    if data.get("domain_separator") != DOMAIN_SEPARATOR:
+        raise AttestationError(
+            E25_TRUST_DOMAIN_SCHEMA_ERROR, "trust domain domain_separator mismatch"
+        )
+    entries = data["public_keys"]
+    if not isinstance(entries, list):
+        raise AttestationError(
+            E25_TRUST_DOMAIN_SCHEMA_ERROR, "public_keys must be a list"
+        )
+    domain: dict[str, dict[str, Any]] = {}
+    for entry in entries:
+        parsed = parse_trust_domain_entry(entry)
+        fingerprint = parsed["fingerprint"]
+        if fingerprint in domain:
+            raise AttestationError(
+                E25_TRUST_DOMAIN_SCHEMA_ERROR, f"duplicate fingerprint {fingerprint}"
+            )
+        domain[fingerprint] = parsed
+    return domain
+
+
+def resolve_trusted_key(
+    domain: dict[str, dict[str, Any]],
+    *,
+    fingerprint: str,
+    issuer: str,
+    signed_at: datetime,
+    require_production: bool = True,
+) -> dict[str, Any]:
+    """The trust-domain binding tuple.
+
+    trusted := fingerprint in domain AND issuer == declared issuer AND
+    signed_at in [not_before, not_after] AND status == active
+    Failure codes are E20 / E21 / E22 / E23 (never merged into one generic code).
+    """
+    entry = domain.get(fingerprint)
+    if entry is None:
+        raise AttestationError(
+            E20_PROVIDER_KEY_UNTRUSTED,
+            f"signer {fingerprint[:12]} is not in the trust domain",
+        )
+    if issuer != entry["issuer"]:
+        raise AttestationError(
+            E21_ISSUER_KEY_BINDING_MISMATCH,
+            "issuer does not match the key's declared issuer",
+        )
+    if require_production and "test" in entry["environment"].lower():
+        raise AttestationError(
+            E24_TEST_KEY_IN_PRODUCTION_TRUST_DOMAIN,
+            "a test-environment key may not sign a formal publication",
+        )
+    if not (entry["not_before"] <= signed_at <= entry["not_after"]):
+        raise AttestationError(
+            E22_KEY_OUTSIDE_VALIDITY_WINDOW,
+            "signed_at is outside the key validity window",
+        )
+    if entry["status"] != "active":
+        raise AttestationError(E23_KEY_REVOKED, "the key is revoked")
+    return entry
+
+
+# ---------------------------------------------------------------------------
+# 5. Budgets (OPEN-D7 parameters -- read, never invented)
+# ---------------------------------------------------------------------------
+
+
+def _optional_positive_number(env_var: str) -> float | None:
+    raw = os.environ.get(env_var)
+    if raw is None or not str(raw).strip():
+        return None
+    try:
+        value = float(raw)
+    except (TypeError, ValueError):
+        return None
+    if value <= 0:
+        return None
+    return value
+
+
+def provider_timeout_seconds() -> float | None:
+    """``T`` -- OPEN-D7.  ``None`` means "not adjudicated" -> refuse the call."""
+    return _optional_positive_number(TIMEOUT_ENV_VAR)
+
+
+def provider_stdout_limit_bytes() -> int | None:
+    """``L`` -- OPEN-D7.  ``None`` means "not adjudicated" -> refuse the call."""
+    value = _optional_positive_number(STDOUT_LIMIT_ENV_VAR)
+    return int(value) if value is not None else None
+
+
+def max_window_seconds() -> float | None:
+    """``W`` -- OPEN-D7.  ``None`` means "no upper bound enforced"."""
+    return _optional_positive_number(MAX_WINDOW_ENV_VAR)
+
+
+# ---------------------------------------------------------------------------
+# 6. Provider transport (one-shot subprocess)
+# ---------------------------------------------------------------------------
+
+
+class ProviderPathState:
+    """Result of the non-executing pre-check on the provider path."""
+
+    __slots__ = ("path", "code", "detail", "read_bytes")
+
+    def __init__(
+        self,
+        path: str | None,
+        code: str | None,
+        detail: str,
+        read_bytes: int | None,
+    ) -> None:
+        self.path = path
+        self.code = code
+        self.detail = detail
+        self.read_bytes = read_bytes
+
+    @property
+    def ok(self) -> bool:
+        return self.code is None
+
+
+def precheck_provider_path() -> ProviderPathState:
+    """Decide whether the configured provider path is even a candidate.
+
+    R-PROV-1: this never reads, executes or imports the file.  ``read_bytes`` is
+    always ``None`` because the implementation deliberately does not open it.
+    ``ok`` only means "the path exists and is a readable file", which is NOT a
+    capability claim (E32 is decided by an actual handshake).
+    """
+    provider = os.environ.get(PROVIDER_ENV_VAR)
+    if not provider or not provider.strip():
+        return ProviderPathState(None, E01_PROVIDER_ABSENT, "no provider configured", None)
+    try:
+        candidate = Path(provider).expanduser()
+        exists = candidate.exists()
+        is_file = candidate.is_file()
+    except OSError as exc:
+        return ProviderPathState(
+            provider, E02_PROVIDER_PATH_UNOPENABLE, f"path not openable: {exc}", None
+        )
+    if not exists or not is_file:
+        return ProviderPathState(
+            provider,
+            E02_PROVIDER_PATH_UNOPENABLE,
+            "provider path does not exist or is not a file",
+            None,
+        )
+    return ProviderPathState(str(candidate), None, "path exists and is a file", None)
+
+
+class ProviderCallResult:
+    """One provider-call attempt: either a response dict or a frozen-code failure."""
+
+    __slots__ = ("response", "code", "detail", "returncode", "stdout_bytes", "elapsed_s")
+
+    def __init__(
+        self,
+        *,
+        response: dict[str, Any] | None,
+        code: str | None,
+        detail: str,
+        returncode: int | None,
+        stdout_bytes: int | None,
+        elapsed_s: float,
+    ) -> None:
+        self.response = response
+        self.code = code
+        self.detail = detail
+        self.returncode = returncode
+        self.stdout_bytes = stdout_bytes
+        self.elapsed_s = elapsed_s
+
+    @property
+    def ok(self) -> bool:
+        return self.code is None and self.response is not None
+
+
+def provider_extra_argv() -> list[str]:
+    """The optional ``REVENUE_ATTESTATION_PROVIDER_ARGV`` tail (JSON list)."""
+    raw = os.environ.get(PROVIDER_ARGV_ENV_VAR)
+    if not raw or not raw.strip():
+        return []
+    try:
+        parsed = json.loads(raw)
+    except ValueError:
+        # A malformed value is a configuration error, not a capability claim:
+        # refuse with the budget/refusal code rather than guessing an argv.
+        raise AttestationError(
+            BUDGET_UNSPECIFIED,
+            f"{PROVIDER_ARGV_ENV_VAR} must be a JSON array of strings",
+        ) from None
+    if not isinstance(parsed, list) or any(not isinstance(item, str) for item in parsed):
+        raise AttestationError(
+            BUDGET_UNSPECIFIED,
+            f"{PROVIDER_ARGV_ENV_VAR} must be a JSON array of strings",
+        )
+    return parsed
+
+
+def _terminate(process: subprocess.Popen) -> None:
+    """Terminate a provider child and reap it; never leave an orphan behind."""
+    if process.poll() is None:
+        try:
+            process.terminate()
+        except OSError:  # pragma: no cover - platform specific
+            pass
+        try:
+            process.wait(timeout=5)
+        except subprocess.TimeoutExpired:  # pragma: no cover - stubborn child
+            try:
+                process.kill()
+            except OSError:
+                pass
+            try:
+                process.wait(timeout=5)
+            except subprocess.TimeoutExpired:
+                pass
+    for stream in (process.stdin, process.stdout, process.stderr):
+        try:
+            if stream is not None:
+                stream.close()
+        except OSError:  # pragma: no cover
+            pass
+
+
+def call_provider(
+    request: dict[str, Any],
+    *,
+    timeout_seconds: float | None = None,
+    stdout_limit_bytes: int | None = None,
+    extra_argv: list[str] | None = None,
+) -> ProviderCallResult:
+    """Invoke the provider exactly once: request on stdin, response on stdout.
+
+    Fails closed with a frozen code.  ``T`` (timeout) and ``L`` (stdout cap) come
+    from OPEN-D7; when either is unset the call is REFUSED instead of being run
+    with an invented budget, and the child is always terminated on the way out.
+
+    ``extra_argv`` exists so a test harness can run "executable + script" as its
+    provider (on Windows a bare ``.py`` path is not executable by the OS).  It
+    never introduces a shell and the configured path stays argv[0].
+    """
+    started = time.monotonic()
+    state = precheck_provider_path()
+    if not state.ok:
+        return ProviderCallResult(
+            response=None,
+            code=state.code,
+            detail=state.detail,
+            returncode=None,
+            stdout_bytes=None,
+            elapsed_s=time.monotonic() - started,
+        )
+    timeout = provider_timeout_seconds() if timeout_seconds is None else timeout_seconds
+    limit = (
+        provider_stdout_limit_bytes()
+        if stdout_limit_bytes is None
+        else stdout_limit_bytes
+    )
+    if timeout is None or limit is None:
+        return ProviderCallResult(
+            response=None,
+            code=BUDGET_UNSPECIFIED,
+            detail=(
+                "OPEN-D7 has not fixed T (timeout) and/or L (stdout cap); "
+                "refusing to call the provider with an invented budget"
+            ),
+            returncode=None,
+            stdout_bytes=None,
+            elapsed_s=time.monotonic() - started,
+        )
+    assert state.path is not None
+    body = json.dumps(request, ensure_ascii=False, sort_keys=True).encode("utf-8")
+    argv = [state.path, *(extra_argv if extra_argv is not None else provider_extra_argv())]
+
+    try:
+        process = subprocess.Popen(  # noqa: S603 - argv is an explicit path, no shell
+            argv,
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            shell=False,
+        )
+    except OSError as exc:
+        # The path existed and was a file, but the platform cannot execute it
+        # (a bare .py source, a .txt, an empty file, a wrong-architecture image).
+        # R-PROV-1: this is "signing capability unproven", never a capability.
+        return ProviderCallResult(
+            response=None,
+            code=E32_PROVIDER_CAPABILITY_UNPROVEN,
+            detail=f"provider could not be started: {exc}",
+            returncode=None,
+            stdout_bytes=None,
+            elapsed_s=time.monotonic() - started,
+        )
+
+    stdout_chunks: list[bytes] = []
+    stderr_chunks: list[bytes] = []
+    over_limit = threading.Event()
+
+    def _drain(stream, sink: list[bytes], cap: int | None) -> None:
+        try:
+            while True:
+                chunk = stream.read(4096)
+                if not chunk:
+                    return
+                sink.append(chunk)
+                if cap is not None and sum(len(item) for item in sink) > cap:
+                    over_limit.set()
+                    return
+        except (OSError, ValueError):  # pragma: no cover - pipe closed under us
+            return
+
+    assert process.stdout is not None and process.stderr is not None
+    stdout_reader = threading.Thread(
+        target=_drain, args=(process.stdout, stdout_chunks, limit), daemon=True
+    )
+    stderr_reader = threading.Thread(
+        target=_drain, args=(process.stderr, stderr_chunks, None), daemon=True
+    )
+    stdout_reader.start()
+    stderr_reader.start()
+    try:
+        try:
+            assert process.stdin is not None
+            process.stdin.write(body)
+            process.stdin.close()
+        except (BrokenPipeError, OSError):
+            # A provider that ignores stdin is not a protocol error by itself;
+            # the response check below decides.  Never crash on the write.
+            pass
+        try:
+            returncode = process.wait(timeout=timeout)
+        except subprocess.TimeoutExpired:
+            _terminate(process)
+            stdout_reader.join(timeout=2)
+            stderr_reader.join(timeout=2)
+            return ProviderCallResult(
+                response=None,
+                code=E07_PROVIDER_TIMEOUT,
+                detail=f"provider exceeded the timeout budget ({timeout}s)",
+                returncode=None,
+                stdout_bytes=None,
+                elapsed_s=time.monotonic() - started,
+            )
+        stdout_reader.join(timeout=5)
+        stderr_reader.join(timeout=5)
+        stdout_bytes = b"".join(stdout_chunks)
+        stderr_text = b"".join(stderr_chunks).decode("utf-8", "replace")
+        elapsed = time.monotonic() - started
+        if over_limit.is_set() or len(stdout_bytes) > limit:
+            return ProviderCallResult(
+                response=None,
+                code=E06_PROVIDER_OUTPUT_TOO_LARGE,
+                detail=f"provider stdout exceeded {limit} bytes; not parsed",
+                returncode=returncode,
+                stdout_bytes=len(stdout_bytes),
+                elapsed_s=elapsed,
+            )
+        if returncode != 0:
+            return ProviderCallResult(
+                response=None,
+                code=E05_PROVIDER_EXIT_NONZERO,
+                detail=(
+                    f"provider exit code {returncode}; stderr={stderr_text.strip()[:400]}"
+                ),
+                returncode=returncode,
+                stdout_bytes=len(stdout_bytes),
+                elapsed_s=elapsed,
+            )
+        text = stdout_bytes.decode("utf-8", "strict") if stdout_bytes else ""
+        try:
+            parsed = json.loads(text)
+        except ValueError as exc:
+            return ProviderCallResult(
+                response=None,
+                code=E04_PROVIDER_INVALID_JSON,
+                detail=f"provider stdout is not JSON: {exc}",
+                returncode=returncode,
+                stdout_bytes=len(stdout_bytes),
+                elapsed_s=elapsed,
+            )
+        if not isinstance(parsed, dict):
+            return ProviderCallResult(
+                response=None,
+                code=E03_PROVIDER_PROTOCOL_VIOLATION,
+                detail="provider stdout is not a single JSON object",
+                returncode=returncode,
+                stdout_bytes=len(stdout_bytes),
+                elapsed_s=elapsed,
+            )
+        if parsed.get("error") == "signing_unavailable":
+            return ProviderCallResult(
+                response=None,
+                code=E10_PROVIDER_SIGNING_UNAVAILABLE,
+                detail="provider reports that it cannot sign",
+                returncode=returncode,
+                stdout_bytes=len(stdout_bytes),
+                elapsed_s=elapsed,
+            )
+        return ProviderCallResult(
+            response=parsed,
+            code=None,
+            detail="ok",
+            returncode=returncode,
+            stdout_bytes=len(stdout_bytes),
+            elapsed_s=elapsed,
+        )
+    finally:
+        _terminate(process)
+
+
+# ---------------------------------------------------------------------------
+# 7. Request / response validation
+# ---------------------------------------------------------------------------
+
+
+def build_request(
+    *,
+    request_id: str,
+    issued_at: str,
+    expires_at: str,
+    payload_sha256: str,
+    input_sha256: str,
+    result_sha256: str,
+    receipt_sha256: str,
+    requested_issuer: str,
+    gate_ids: tuple[str, ...] = (),
+    domain_separator: str = DOMAIN_SEPARATOR,
+) -> dict[str, Any]:
+    """The exact ``attestation_request`` field set (more or fewer fields break it)."""
+    request = {
+        "attestation_request_schema_version": ATTESTATION_REQUEST_SCHEMA_VERSION,
+        "request_id": request_id,
+        "issued_at": issued_at,
+        "expires_at": expires_at,
+        "domain_separator": domain_separator,
+        "payload_sha256": payload_sha256,
+        "input_sha256": input_sha256,
+        "result_sha256": result_sha256,
+        "receipt_sha256": receipt_sha256,
+        "engine_version": ENGINE_VERSION,
+        "forecast_schema_version": FORECAST_SCHEMA_VERSION,
+        "publication_receipt_schema_version": PUBLICATION_RECEIPT_SCHEMA_VERSION,
+        "requested_issuer": requested_issuer,
+        "gate_ids": list(gate_ids),
+    }
+    _require_exact_fields(
+        request, REQUEST_FIELDS, E08_PROVIDER_SCHEMA_MISMATCH, "attestation_request"
+    )
+    return request
+
+
+def validate_response(response: Any, request: dict[str, Any]) -> dict[str, Any]:
+    """Validate the provider response: field set, version, echo, signature shape.
+
+    Order matters and is frozen: schema (E08) -> protocol version (E03) -> echo
+    (E09) -> signature shape (E13).  The cryptographic check happens later, after
+    the trust-domain binding, so the caller can report the most specific code.
+    """
+    _require_exact_fields(
+        response, RESPONSE_FIELDS, E08_PROVIDER_SCHEMA_MISMATCH, "attestation_response"
+    )
+    assert isinstance(response, dict)
+    if response["attestation_response_schema_version"] != (
+        ATTESTATION_RESPONSE_SCHEMA_VERSION
+    ):
+        raise AttestationError(
+            E03_PROVIDER_PROTOCOL_VIOLATION, "unsupported response schema version"
+        )
+    for field in ECHO_FIELDS:
+        value = response[field]
+        if not isinstance(value, str) or value != request[field]:
+            raise AttestationError(
+                E09_PROVIDER_BINDING_MISMATCH,
+                f"{field} echo is not byte-identical to the request",
+            )
+    for field in ("issuer", "key_id"):
+        if not isinstance(response[field], str) or not response[field].strip():
+            raise AttestationError(
+                E08_PROVIDER_SCHEMA_MISMATCH, f"{field} must be a non-empty string"
+            )
+    if response["signature_algorithm"] != SIGNATURE_ALGORITHM:
+        raise AttestationError(
+            E08_PROVIDER_SCHEMA_MISMATCH, "signature_algorithm must be ed25519"
+        )
+    fingerprint = response["key_fingerprint"]
+    if not isinstance(fingerprint, str) or _HEX32.fullmatch(fingerprint) is None:
+        raise AttestationError(
+            E13_ATTESTATION_MALFORMED_SIGNATURE,
+            "key_fingerprint must be 32 lowercase hex",
+        )
+    signature = response["signature"]
+    if not isinstance(signature, str) or _HEX128.fullmatch(signature) is None:
+        raise AttestationError(
+            E13_ATTESTATION_MALFORMED_SIGNATURE,
+            "signature must be 128 lowercase hex",
+        )
+    parse_utc(response["signed_at"], "signed_at", E08_PROVIDER_SCHEMA_MISMATCH)
+    return response
+
+
+def response_to_payload(
+    response: dict[str, Any],
+    request: dict[str, Any],
+    *,
+    gate_ids: tuple[str, ...] = (),
+) -> dict[str, Any]:
+    """Assemble the signed payload (excluding the signature domain itself)."""
+    payload = {
+        "attestation_payload_schema_version": ATTESTATION_PAYLOAD_SCHEMA_VERSION,
+        "domain_separator": response["domain_separator"],
+        "issuer": response["issuer"],
+        "key_id": response["key_id"],
+        "key_fingerprint": response["key_fingerprint"],
+        "algorithm": response["signature_algorithm"],
+        "request_id": response["request_id"],
+        "issued_at": request["issued_at"],
+        "expires_at": request["expires_at"],
+        "signed_at": response["signed_at"],
+        "input_sha256": request["input_sha256"],
+        "payload_sha256": request["payload_sha256"],
+        "result_sha256": request["result_sha256"],
+        "receipt_sha256": request["receipt_sha256"],
+        "engine_version": request["engine_version"],
+        "forecast_schema_version": request["forecast_schema_version"],
+        "publication_receipt_schema_version": request[
+            "publication_receipt_schema_version"
+        ],
+        "validator_version": ENGINE_VERSION,
+        "gate_ids": list(gate_ids),
+    }
+    _require_exact_fields(
+        payload, PAYLOAD_FIELDS, E15_ATTESTATION_PAYLOAD_FIELDS, "attestation_payload"
+    )
+    return payload
+
+
+def validate_payload(payload: Any) -> dict[str, Any]:
+    """Validate a signed payload: exact field set, shapes, versions, window."""
+    _require_exact_fields(
+        payload, PAYLOAD_FIELDS, E15_ATTESTATION_PAYLOAD_FIELDS, "attestation_payload"
+    )
+    assert isinstance(payload, dict)
+    if payload["attestation_payload_schema_version"] != (
+        ATTESTATION_PAYLOAD_SCHEMA_VERSION
+    ):
+        raise AttestationError(
+            E15_ATTESTATION_PAYLOAD_FIELDS, "unsupported payload schema version"
+        )
+    if payload["domain_separator"] != DOMAIN_SEPARATOR:
+        raise AttestationError(
+            E17_ATTESTATION_DOMAIN_MISMATCH, "payload domain_separator mismatch"
+        )
+    for field in ("issuer", "key_id"):
+        _require_text(payload[field], field)
+    if payload["algorithm"] != SIGNATURE_ALGORITHM:
+        raise AttestationError(
+            E15_ATTESTATION_PAYLOAD_FIELDS, "algorithm must be ed25519"
+        )
+    if not isinstance(payload["key_fingerprint"], str) or (
+        _HEX32.fullmatch(payload["key_fingerprint"]) is None
+    ):
+        raise AttestationError(
+            E15_ATTESTATION_PAYLOAD_FIELDS, "key_fingerprint must be 32 lowercase hex"
+        )
+    for field in (
+        "request_id",
+        "input_sha256",
+        "payload_sha256",
+    ):
+        _require_hex64(payload[field], field)
+    # result_sha256 / receipt_sha256 cover the WHOLE artifact, including this
+    # record, so they are computed after signing and cannot be embedded at the
+    # publish instant.  The design's own rule is to exclude self-referential
+    # fields; the honest encoding is therefore the empty commitment, and the
+    # cryptographic binding is carried by payload_sha256 (the projection the
+    # validator recomputes).  See decision.md "self-reference circularity".
+    for field in ("result_sha256", "receipt_sha256"):
+        if payload[field] != "":
+            _require_hex64(payload[field], field)
+    gates = payload["gate_ids"]
+    if not isinstance(gates, list) or any(not isinstance(item, str) for item in gates):
+        raise AttestationError(
+            E15_ATTESTATION_PAYLOAD_FIELDS, "gate_ids must be a list of strings"
+        )
+    # Version fields are checked before the hash-shape checks: a tampered version
+    # must be reported as a version mismatch (E11), not as a malformed hash.
+    runtime = {
+        "engine_version": ENGINE_VERSION,
+        "forecast_schema_version": FORECAST_SCHEMA_VERSION,
+        "publication_receipt_schema_version": PUBLICATION_RECEIPT_SCHEMA_VERSION,
+    }
+    for field in PAYLOAD_VERSION_FIELDS:
+        expected = runtime.get(field, ENGINE_VERSION)
+        if payload[field] != expected:
+            raise AttestationError(
+                E11_PROVIDER_VERSION_MISMATCH,
+                f"{field} does not match the running runtime",
+            )
+    for field in (
+        "request_id",
+        "input_sha256",
+        "payload_sha256",
+    ):
+        _require_hex64(payload[field], field)
+    # result_sha256 / receipt_sha256 cover the WHOLE artifact, including this
+    # record, so they are computed after signing and cannot be embedded at the
+    # publish instant.  The design's own rule is to exclude self-referential
+    # fields; the honest encoding is therefore the empty commitment, and the
+    # cryptographic binding is carried by payload_sha256 (the projection the
+    # validator recomputes).  See decision.md "self-reference circularity".
+    for field in ("result_sha256", "receipt_sha256"):
+        if payload[field] != "":
+            _require_hex64(payload[field], field)
+
+    issued_at = parse_utc(payload["issued_at"], "issued_at")
+    expires_at = parse_utc(payload["expires_at"], "expires_at")
+    signed_at = parse_utc(payload["signed_at"], "signed_at")
+    if issued_at > signed_at or signed_at > expires_at:
+        raise AttestationError(
+            E18_ATTESTATION_EXPIRED_AT_PUBLISH,
+            "the publish instant is outside [issued_at, expires_at]",
+        )
+    window = max_window_seconds()
+    if window is not None and (signed_at - issued_at) > timedelta(seconds=window):
+        raise AttestationError(
+            E18_ATTESTATION_EXPIRED_AT_PUBLISH,
+            f"the publication window exceeds the configured W ({window}s)",
+        )
+    return payload
+
+
+def verify_signed_payload(
+    payload: dict[str, Any], signature: str, domain: dict[str, dict[str, Any]]
+) -> dict[str, Any]:
+    """Verify the Ed25519 signature and the trust-domain tuple for a payload."""
+    from cryptography.exceptions import InvalidSignature
+    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey
+
+    validate_payload(payload)
+    if not isinstance(signature, str) or _HEX128.fullmatch(signature) is None:
+        raise AttestationError(
+            E13_ATTESTATION_MALFORMED_SIGNATURE,
+            "signature must be 128 lowercase hex",
+        )
+    signed_at = parse_utc(payload["signed_at"], "signed_at")
+    # Order matters and is frozen: (1) is the key even in the trust domain (E20),
+    # (2) does the signature verify (E14), (3) do the binding rules hold
+    # (E21/E22/E23/E24).  Checking the signature first would report a tampered
+    # payload as a binding mismatch, and looking the key up first is required so
+    # an untrusted signer is named as such rather than as a bad signature.
+    entry = _entry(domain, payload["key_fingerprint"])
+    try:
+        public_key = Ed25519PublicKey.from_public_bytes(entry["public_key"])
+        public_key.verify(bytes.fromhex(signature), signed_message(payload))
+    except (InvalidSignature, ValueError) as exc:
+        raise AttestationError(
+            E14_ATTESTATION_SIGNATURE_INVALID, "signature verification failed"
+        ) from exc
+    return resolve_trusted_key(
+        domain,
+        fingerprint=payload["key_fingerprint"],
+        issuer=payload["issuer"],
+        signed_at=signed_at,
+    )
+
+
+def _entry(domain: dict[str, dict[str, Any]], fingerprint: str) -> dict[str, Any]:
+    """The trust-domain entry for *fingerprint*, or E20 when it is not trusted."""
+    entry = domain.get(fingerprint)
+    if entry is None:
+        raise AttestationError(
+            E20_PROVIDER_KEY_UNTRUSTED,
+            f"signer {fingerprint[:12]} is not in the trust domain",
+        )
+    return entry
+
+
+def build_attestation_record(
+    response: dict[str, Any],
+    request: dict[str, Any],
+    *,
+    gate_ids: tuple[str, ...],
+    w_enforced: bool,
+    domain: dict[str, dict[str, Any]],
+    verify: bool = True,
+) -> dict[str, Any]:
+    """Turn a validated response into the verified L3 attestation record.
+
+    The signed payload keeps the payload vocabulary (``algorithm`` /
+    ``attestation_payload_schema_version``); the record that carries it names the
+    same two values ``signature_algorithm`` / ``attestation_record_schema_version``
+    (that is the frozen record field set).  The signature is verified over the
+    payload bytes, which is exactly what the provider signed.
+
+    ``verify=False`` still validates the payload structure but skips the
+    trust-domain/signature judgement.  It exists so a test can CONSTRUCT a record
+    that the verifier is then expected to reject (an untrusted key, a revoked key,
+    a key outside its validity window) without the builder refusing first.
+    """
+    payload = response_to_payload(response, request, gate_ids=gate_ids)
+    if verify:
+        verify_signed_payload(payload, response["signature"], domain)
+    else:
+        validate_payload(payload)
+    record = {
+        "attestation_record_schema_version": payload[
+            "attestation_payload_schema_version"
+        ],
+        **{
+            key: value
+            for key, value in payload.items()
+            if key not in ("algorithm", "attestation_payload_schema_version")
+        },
+        "signature_algorithm": payload["algorithm"],
+        "signature": response["signature"],
+        "W_enforced": w_enforced,
+    }
+    _require_exact_fields(
+        record,
+        ATTESTATION_RECORD_FIELDS,
+        E15_ATTESTATION_PAYLOAD_FIELDS,
+        "attestation_record",
+    )
+    return record
+
+
+def record_to_payload(record: Any) -> dict[str, Any]:
+    """Strip the record down to its signed payload (the exact signed bytes).
+
+    The record field set names two values differently from the payload field set
+    (``attestation_record_schema_version`` / ``signature_algorithm`` versus
+    ``attestation_payload_schema_version`` / ``algorithm``).  A record in EITHER
+    vocabulary is accepted here and normalised, so callers never have to know
+    which of the two equivalent names they are holding.
+    """
+    _require_exact_fields(
+        record,
+        ATTESTATION_RECORD_FIELDS,
+        E15_ATTESTATION_PAYLOAD_FIELDS,
+        "attestation_record",
+    )
+    assert isinstance(record, dict)
+    payload = {field: record[field] for field in PAYLOAD_FIELDS if field in record}
+    if "algorithm" not in payload:
+        payload["algorithm"] = record.get("signature_algorithm")
+    if "attestation_payload_schema_version" not in payload:
+        payload["attestation_payload_schema_version"] = record.get(
+            "attestation_record_schema_version"
+        )
+    if any(payload[field] is None for field in ("algorithm", "attestation_payload_schema_version")):
+        raise AttestationError(
+            E15_ATTESTATION_PAYLOAD_FIELDS,
+            "the record names neither the algorithm nor the payload schema version",
+        )
+    # A COPY, never a view onto the caller's record: callers mutate the returned
+    # payload (e.g. to build a tampered candidate), and handing back shared state
+    # would silently corrupt the original record.
+    return dict(payload)
+
+
+def verify_attestation_record(
+    record: Any, *, domain: dict[str, dict[str, Any]] | None = None
+) -> dict[str, Any]:
+    """Verify a stored L3 attestation record (E12/E13/E14/E15/E17/E20..E24)."""
+    if not isinstance(record, dict):
+        raise AttestationError(
+            E12_ATTESTATION_MISSING_SIGNATURE, "attestation record must be an object"
+        )
+    if "signature" not in record:
+        raise AttestationError(
+            E12_ATTESTATION_MISSING_SIGNATURE, "attestation record carries no signature"
+        )
+    signature = record["signature"]
+    if not isinstance(signature, str) or _HEX128.fullmatch(signature) is None:
+        raise AttestationError(
+            E13_ATTESTATION_MALFORMED_SIGNATURE,
+            "signature must be 128 lowercase hex",
+        )
+    payload = record_to_payload(record)
+    trusted = load_trust_domain() if domain is None else domain
+    return verify_signed_payload(payload, signature, trusted)
+
+
+# ---------------------------------------------------------------------------
+# 8. Publication composition (called by run_forecast)
+# ---------------------------------------------------------------------------
+
+
+def new_request_id() -> str:
+    """A one-shot nonce for one publication request (never reused)."""
+    return os.urandom(32).hex()
+
+
+class PublicationAttestation:
+    """Outcome of the L3 signing attempt for one publication."""
+
+    __slots__ = (
+        "status",
+        "record",
+        "code",
+        "detail",
+        "provider_invocations",
+        "handshake_ok",
+        "w_enforced",
+        "observed_window_seconds",
+        "trust_domain_size",
+    )
+
+    def __init__(
+        self,
+        *,
+        status: str,
+        record: dict[str, Any] | None,
+        code: str | None,
+        detail: str,
+        provider_invocations: int,
+        handshake_ok: bool,
+        w_enforced: bool,
+        observed_window_seconds: float | None,
+        trust_domain_size: int,
+    ) -> None:
+        self.status = status
+        self.record = record
+        self.code = code
+        self.detail = detail
+        self.provider_invocations = provider_invocations
+        self.handshake_ok = handshake_ok
+        self.w_enforced = w_enforced
+        self.observed_window_seconds = observed_window_seconds
+        self.trust_domain_size = trust_domain_size
+
+
+def _failure(
+    code: str,
+    detail: str,
+    *,
+    invocations: int,
+    w_enforced: bool,
+    observed_window: float | None,
+    trust_domain_size: int,
+) -> PublicationAttestation:
+    return PublicationAttestation(
+        status="unattested",
+        record=None,
+        code=code,
+        detail=detail,
+        provider_invocations=invocations,
+        handshake_ok=False,
+        w_enforced=w_enforced,
+        observed_window_seconds=observed_window,
+        trust_domain_size=trust_domain_size,
+    )
+
+
+def attestation_capability() -> bool:
+    """True only when a provider handshake has actually succeeded.
+
+    R-PROV-1: a file that merely exists (even ``sys.executable``, even a ``.py``
+    source, even a ``.txt``) is NOT capability evidence.  Capability means: the
+    provider was called once and returned a response whose echo, schema and
+    signature all verified against the trust domain.
+    """
+    try:
+        outcome = attest_publication(
+            payload_sha256="0" * 64,
+            input_sha256="0" * 64,
+            result_sha256="0" * 64,
+            receipt_sha256="0" * 64,
+            gate_ids=(),
+            requested_issuer="capability-probe",
+        )
+    except (AttestationError, ForecastInputError):
+        # A damaged trust domain (E25) is not capability either; the publication
+        # path re-raises it loudly, this predicate stays a boolean.
+        return False
+    return outcome.status == "host_signed"
+
+
+def attest_publication(
+    *,
+    payload_sha256: str,
+    input_sha256: str,
+    result_sha256: str,
+    receipt_sha256: str,
+    gate_ids: tuple[str, ...],
+    requested_issuer: str,
+    now: datetime | None = None,
+    provider_argv: list[str] | None = None,
+) -> PublicationAttestation:
+    """Run the full L3 handshake+verification funnel exactly once.
+
+    Returns an outcome whose ``status`` is ``"host_signed"`` ONLY when a trusted
+    signature verified.  Every other path returns ``"unattested"`` plus the frozen
+    failure code.  ``provider_invocations`` is 0 or 1 -- never more.
+    """
+    window = max_window_seconds()
+    w_enforced = window is not None
+    instant = now or datetime.now(timezone.utc)
+    issued = instant - timedelta(seconds=1)
+    if window is not None:
+        expires = issued + timedelta(seconds=window)
+    else:
+        # W is NOT adjudicated: the window is a bounded placeholder that is
+        # reported verbatim as observed_window_seconds with W_enforced=false.
+        # This is not a normative value; it only keeps expires_at > issued_at.
+        expires = instant + timedelta(seconds=int(instant.timestamp()) % 3600 + 60)
+    observed_window = (expires - issued).total_seconds()
+
+    state = precheck_provider_path()
+    if not state.ok:
+        return _failure(
+            state.code or E02_PROVIDER_PATH_UNOPENABLE,
+            state.detail,
+            invocations=0,
+            w_enforced=w_enforced,
+            observed_window=observed_window,
+            trust_domain_size=0,
+        )
+    trust = load_trust_domain()  # may raise E25 -> caller aborts publication
+    request = build_request(
+        request_id=new_request_id(),
+        issued_at=rfc3339_z(issued),
+        expires_at=rfc3339_z(expires),
+        payload_sha256=payload_sha256,
+        input_sha256=input_sha256,
+        result_sha256=result_sha256,
+        receipt_sha256=receipt_sha256,
+        requested_issuer=requested_issuer,
+        gate_ids=gate_ids,
+    )
+    result = call_provider(request, extra_argv=provider_argv)
+    if not result.ok:
+        return _failure(
+            result.code or E03_PROVIDER_PROTOCOL_VIOLATION,
+            result.detail,
+            invocations=0 if result.returncode is None else 1,
+            w_enforced=w_enforced,
+            observed_window=observed_window,
+            trust_domain_size=len(trust),
+        )
+    assert result.response is not None
+    # Any post-call failure inside the response funnel fails CLOSED to the
+    # unattested status carrying the normative code.  ``attest_publication`` never
+    # raises for a provider-originated problem: it reports it, so a caller cannot
+    # mistake a malformed or unverifiable response for a signature.  (A trust
+    # domain that cannot be parsed still raises E25 before the call: that is a
+    # configuration abort, not a provider outcome.)
+    try:
+        response = validate_response(result.response, request)
+        record = build_attestation_record(
+            response, request, gate_ids=gate_ids, w_enforced=w_enforced, domain=trust
+        )
+    except AttestationError as exc:
+        return _failure(
+            exc.code,
+            exc.detail or str(exc),
+            invocations=1,
+            w_enforced=w_enforced,
+            observed_window=observed_window,
+            trust_domain_size=len(trust),
+        )
+    return PublicationAttestation(
+        status="host_signed",
+        record=record,
+        code=None,
+        detail="handshake and signature verification succeeded",
+        provider_invocations=1,
+        handshake_ok=True,
+        w_enforced=w_enforced,
+        observed_window_seconds=observed_window,
+        trust_domain_size=len(trust),
+    )
+
+
+# ---------------------------------------------------------------------------
+# 9. Result-level validation and legacy classification
+# ---------------------------------------------------------------------------
+
+
+def payload_sha256(result: dict[str, Any]) -> str:
+    """``canonical_sha256`` of the artifact MINUS the self-referential fields.
+
+    The projection is INCLUSIVE: every result key is committed to, except the ones
+    that cannot be, and all for the same reason —
+
+    * ``result_sha256`` / ``publication_receipt``: the design's own exclusion list
+      (they are digests/containers of the artifact itself);
+    * ``publication_attestation``: the L3 record CONTAINS this hash, so no hash can
+      honestly cover it;
+    * ``UNSIGNED_APPENDIX_KEYS``: the outcome report, only knowable after the
+      signing attempt;
+    * ``payload_sha256``: the artifact's own STATEMENT of this hash.  It is exported
+      for signed publications so the stated commitment and the record's commitment
+      can be compared, and it is checked in :func:`verify_publication_attestation`.
+      Leaving it inside the projection would make the commitment depend on itself.
+
+    Including everything else is deliberate.  An earlier revision excluded only the
+    first two, which meant the commitment did NOT cover ``sources``,
+    ``parameter_trace``, ``data_gaps`` or ``disconfirming_indicators`` while the
+    function was named as if it bound the whole artifact.  Those four keys are
+    present on the draft BEFORE signing, so committing to them costs nothing and
+    closes that gap.
+    """
+    return canonical_sha256(
+        {
+            key: value
+            for key, value in result.items()
+            if key
+            not in (
+                "result_sha256",
+                "publication_receipt",
+                "publication_attestation",
+                "payload_sha256",
+            )
+            and key not in UNSIGNED_APPENDIX_KEYS
+        }
+    )
+
+
+def verify_publication_attestation(result: dict[str, Any]) -> list[str]:
+    """Non-throwing re-verification, for historical artifacts (R-REPLAY-1).
+
+    Returns the list of frozen failure codes (empty == verified).  ``expires_at``
+    is NOT applied here: it constrains the publish instant, never the read.
+
+    Three independent bindings are checked:
+
+    1. the record's own signature and trust-domain tuple (E12-E24);
+    2. **the record's commitment against the artifact recomputed right now**:
+       ``record["payload_sha256"]`` must equal ``payload_sha256(result)``.  This is
+       the check that makes the commitment mean something.  An earlier revision
+       compared the record against ``result.get("payload_sha256")`` — a key a real
+       artifact did not carry, so ``isinstance(None, str)`` was false and the rule
+       NEVER RAN (measured by the independent review: a mutation of a covered field
+       still returned no findings);
+    3. the artifact's own stated commitment, when present: ``run_forecast`` exports
+       ``result["payload_sha256"]`` for a signed publication, and it must equal both
+       the record's commitment and the projection recomputed here.  Checking it
+       explicitly means two independent statements must agree, and it is what makes a
+       real-artifact mutation testable at all;
+    4. the artifact's claims about ``input_sha256`` and ``forecast_schema_version``,
+       when it carries them, against the record.
+    """
+    findings: list[str] = []
+
+    def fail_once(code: str) -> None:
+        """Report each frozen code at most once: the caller matches on codes."""
+        if code not in findings:
+            findings.append(code)
+
+    record = result.get("publication_attestation")
+    if record is None:
+        return [E26_ATTESTATION_ABSENT]
+    try:
+        verify_attestation_record(record)
+    except AttestationError as exc:
+        findings.append(exc.code)
+        return findings
+    except ForecastInputError as exc:  # pragma: no cover - defensive
+        findings.append(str(exc))
+        return findings
+    # (2) the record's commitment vs the artifact as it is NOW
+    recomputed = payload_sha256(result)
+    if record.get("payload_sha256") != recomputed:
+        fail_once(E16_ATTESTATION_PAYLOAD_HASH_MISMATCH)
+    # (3) the artifact's OWN stated commitment, when the publisher exported it
+    stated = result.get("payload_sha256")
+    if isinstance(stated, str) and stated != recomputed:
+        fail_once(E16_ATTESTATION_PAYLOAD_HASH_MISMATCH)
+    # (4) plain-text claims, when present
+    claimed_input = result.get("input_sha256")
+    if isinstance(claimed_input, str) and claimed_input != record.get("input_sha256"):
+        fail_once(E16_ATTESTATION_PAYLOAD_HASH_MISMATCH)
+    claimed_version = result.get("forecast_schema_version")
+    if isinstance(claimed_version, str) and claimed_version != record.get(
+        "forecast_schema_version"
+    ):
+        fail_once(E16_ATTESTATION_PAYLOAD_HASH_MISMATCH)
+    return findings
+
+
+def _receipt_claims_host_signed(result: dict[str, Any]) -> bool:
+    receipt = result.get("publication_receipt")
+    return isinstance(receipt, dict) and receipt.get("attestation_status") == (
+        "host_signed"
+    )
+
+
+def classify(result: dict[str, Any]) -> tuple[str, str | None]:
+    """The single legacy-classification judgement (decision.md section 6.1).
+
+    Returns ``(class, code_or_None)`` where class is one of
+    ``G1``/``G2``/``G3a``/``G4``.  The judgement key is "did the artifact make a
+    signing claim", never "is the version different from the current one".
+    """
+    receipt = result.get("publication_receipt")
+    receipt = receipt if isinstance(receipt, dict) else {}
+    record = result.get("publication_attestation")
+    if record is not None:
+        findings = verify_publication_attestation(result)
+        if findings:
+            return G4, findings[0]
+        return G2, None
+    if receipt.get("attestation_status") == "host_signed":
+        return G4, E27_ATTESTATION_MISSING_RECORD
+    version = result.get("schema_version") or receipt.get("schema_version")
+    if version in G1_VERSIONS:
+        return G1, E28_LEGACY_READ_ONLY
+    if version in {FORECAST_SCHEMA_VERSION, "3.8"}:
+        return G3A, E26_ATTESTATION_ABSENT
+    return G4, E26_ATTESTATION_ABSENT
+
+
+def is_legacy_exempt(schema_version: Any) -> bool:
+    """R-LEGACY-1: ONLY the explicit G1 version set may be treated as legacy.
+
+    ``schema_version != FORECAST_SCHEMA_VERSION`` is forbidden as an exemption
+    predicate: it would silently exempt the opt-in 3.8 schema from the registry
+    and attestation gates (E29).  Wiring this predicate into the cross-repo
+    consumer is OPEN-D6 and is NOT done by this card.
+    """
+    return schema_version in G1_VERSIONS
+
+
+def require_legacy_exemption(schema_version: Any) -> bool:
+    """The gate a consumer MUST call instead of deriving its own exemption.
+
+    Returns ``True`` when the explicit G1 set grants the exemption.  Raises
+    :data:`E29_LEGACY_EXEMPTION_NOT_ALLOWED_FOR_OPTIN_SCHEMA` when the caller is
+    about to grant an exemption that R-LEGACY-1 forbids — which today means any
+    non-G1 version, in particular the current 3.7 and the opt-in 3.8 (the schema
+    that must pass BOTH the registry gate and the attestation gate).
+
+    Why this exists: the design froze the E29 code in the single table, but a
+    predicate alone can only ever answer "no"; it cannot REPORT that an exemption
+    was wrongly claimed.  This function is the reportable half, so the code is
+    reachable and testable in this repository.  Wiring it into invest-core remains
+    OPEN-D6 and is explicitly NOT done here.
+    """
+    if is_legacy_exempt(schema_version):
+        return True
+    raise AttestationError(
+        E29_LEGACY_EXEMPTION_NOT_ALLOWED_FOR_OPTIN_SCHEMA,
+        f"schema {schema_version!r} is not in the explicit G1 version set "
+        f"{sorted(G1_VERSIONS)} and may not receive a legacy exemption",
+    )
+
+
+def require_class_permits(result: dict[str, Any], *, require_attestation: bool) -> str:
+    """Enforce the classification gates; raise with the frozen code on refusal."""
+    klass, code = classify(result)
+    if klass == G4:
+        raise AttestationError(
+            code or E27_ATTESTATION_MISSING_RECORD,
+            f"artifact rejected (class {klass})",
+        )
+    if require_attestation and klass in {G1, G3A}:
+        raise AttestationError(
+            code or E26_ATTESTATION_ABSENT,
+            f"class {klass} may not pass a gate that requires an attestation",
+        )
+    return klass
+
+
+# ---------------------------------------------------------------------------
+# 10. Re-exported request-ID ledger (E19)
+# ---------------------------------------------------------------------------
+
+
+class RequestIdLedger:
+    """Tracks one-shot ``request_id`` values (E19) for the running process.
+
+    A ``request_id`` may be reused only for an IDENTICAL payload; reusing it for a
+    different payload hash is rejected.  The ledger deliberately does NOT gate
+    historical re-verification (R-REPLAY-1).
+    """
+
+    __slots__ = ("_seen",)
+
+    def __init__(self) -> None:
+        self._seen: dict[str, str] = {}
+
+    def observe(self, request_id: str, payload_sha256: str) -> None:
+        previous = self._seen.get(request_id)
+        if previous is not None and previous != payload_sha256:
+            raise AttestationError(
+                E19_REQUEST_ID_REUSE,
+                "this request_id was already used for a different payload",
+            )
+        self._seen[request_id] = payload_sha256
+
+
+_LEDGER = RequestIdLedger()
+
+
+def request_id_ledger() -> RequestIdLedger:
+    return _LEDGER
+
