+        from revenue_core import run_forecast
+        from test_recognition_bridge import forecast_document
+
+        self.install_valid_domain(
+            entry={
+                "not_before": _utc(-86400 * domain_days),
+                "not_after": _utc(86400 * domain_days),
+            }
+        )
