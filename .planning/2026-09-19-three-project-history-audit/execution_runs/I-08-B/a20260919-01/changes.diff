+class ErrorCodeTableTests(FakeProviderHarness):
+    """The normative table itself (single source of truth)."""
+
+    def test_table_is_complete_and_unique(self) -> None:
+        self.assertEqual(len(ERROR_CODES), 32)
+        self.assertEqual(len(set(ERROR_CODES.values())), 32)
+        self.assertEqual(sorted(ERROR_CODES), [f"E{i:02d}" for i in range(1, 33)])
+        self.assertEqual(ERROR_CODES["E32"], "provider_capability_unproven")
+        self.assertEqual(ERROR_CODES["E25"], "trust_domain_schema_error")
+        self.assertEqual(ERROR_CODES["E27"], "attestation_missing_record")
+        self.assertFalse(BUDGET_UNSPECIFIED.startswith("E"))
+
+    def test_protocol_field_sets_are_frozen(self) -> None:
+        self.assertEqual(len(REQUEST_FIELDS), 14)
+        self.assertEqual(len(RESPONSE_FIELDS), 10)
+        self.assertEqual(len(PAYLOAD_FIELDS), 19)
+        self.assertEqual(len(ATTESTATION_RECORD_FIELDS), 21)
+        self.assertIn("gate_ids", REQUEST_FIELDS)
+        self.assertIn("gate_ids", PAYLOAD_FIELDS)
+        # the self-reference exclusions
+        for excluded in ("signature", "signature_algorithm", "publication_receipt"):
+            self.assertNotIn(excluded, PAYLOAD_FIELDS)
+
