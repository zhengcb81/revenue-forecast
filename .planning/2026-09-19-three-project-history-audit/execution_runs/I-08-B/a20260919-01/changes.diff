+"""I-08-B provider-protocol, signature, replay/expiry and trust-domain tests.
+
+Every case asserts EXACTLY one frozen error code from the single normative table
+(``decision.md`` section 2.5, mirrored by ``oracle.md`` section 1).  The provider
+is the bounded fake in ``tests/e2e_support/i08b_fake_provider.py`` and the trust
+domain is an attempt-local file whose ONLY key material is an ephemeral Ed25519
+key generated inside the test process.
+
+Isolation rules honoured here:
+  * no network, no real key service, no production registry, no production config;
+  * the private key never enters a trust-domain file, a receipt or a log;
+  * ``environment`` of the trusted entry is a non-test string, because a
+    test-environment key is rejected on the formal path by design (E24);
+  * the whole ``I08B_FAKE_*`` fault-injection namespace is restored per test, so
+    one case can never pass because of a previous case's leftover.
+"""
+
+from __future__ import annotations
+
+import base64
+import copy
+import hashlib
+import json
+import os
+import sys
+import tempfile
+import unittest
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))
+
+import attestation_protocol as ap  # noqa: E402
+from attestation_protocol import (  # noqa: E402
+    ATTESTATION_RECORD_FIELDS,
+    BUDGET_UNSPECIFIED,
+    DOMAIN_SEPARATOR,
+    ERROR_CODES,
+    PAYLOAD_FIELDS,
+    REQUEST_FIELDS,
+    RESPONSE_FIELDS,
+    AttestationError,
+    build_request,
+    call_provider,
+    classify,
+    load_trust_domain,
+    record_to_payload,
+    rfc3339_z,
+    verify_attestation_record,
+    verify_publication_attestation,
+)
+
+FAKE_PROVIDER = Path(__file__).resolve().parent / "e2e_support" / "i08b_fake_provider.py"
+ISSUER = "revenue-forecast/host-a"
+KEY_ID = "rf-test-2026a"
+TIMEOUT_S = 20.0
+LIMIT_BYTES = 65536
+W_TEST = 3600.0
+GATES = ("output_recomputation",)
+
+
+def _utc(offset_seconds: float = 0.0) -> str:
+    return rfc3339_z(datetime.now(timezone.utc) + timedelta(seconds=offset_seconds))
+
+
+def _clock(base: datetime):
+    """An anchored clock: all stamps come from ONE instant.
+
+    Calling ``_utc`` twice with different offsets lets wall-clock drift decide
+    which half of a rule fires; anchoring removes that race from every case.
+    """
+
+    def stamp(offset_seconds: float) -> str:
+        return rfc3339_z(base + timedelta(seconds=offset_seconds))
+
+    return stamp
+
+
+def _artifact(record: dict, *, status: str = "host_signed", **extra) -> dict:
+    """A minimal artifact carrying a record, for verify_publication_attestation().
+
+    Two deliberate properties:
+
+    * it does NOT carry a top-level ``forecast_schema_version`` by default, because
+      that key is inside the hashed projection and the schema-version case sets it
+      on purpose;
+    * it DOES carry the commitment a signed publication states, exactly as
+      ``run_forecast`` emits it, so the stated commitment and the record's
+      commitment can both be checked.  ``extra`` overrides either on purpose.
+    """
+    artifact = {
+        "schema_version": "3.7",
+        "publication_receipt": {"attestation_status": status, "schema_version": "3.7"},
+        "publication_attestation": record,
+        "input_sha256": record["input_sha256"],
+        "payload_sha256": record["payload_sha256"],
+    }
+    artifact.update(extra)
+    return artifact
+
+
+#: The projection must be composed of keys that EXIST in the artifact it names.
+#: A record signed over a request-shaped dict therefore commits to nothing an
+#: artifact can reproduce, which is why the replay/re-verification cases below sign
+#: REAL ``run_forecast`` artifacts instead of harness-built ones.
+
+
+def _record_payload(record: dict) -> dict:
+    """The payload fields of a record, re-derived independently of the module."""
+    payload = {field: record[field] for field in PAYLOAD_FIELDS if field in record}
+    payload.setdefault(
+        "attestation_payload_schema_version",
+        record.get("attestation_record_schema_version"),
+    )
+    payload.setdefault("algorithm", record.get("signature_algorithm"))
+    return payload
+
+
+class FakeProviderHarness(unittest.TestCase):
+    """Shared isolation harness: ephemeral key + isolated trust domain.
+
+    Every stamp the tests reason about is derived from ONE module-level anchor and
+    injected explicitly into the provider (``I08B_FAKE_SIGNED_AT``).  The wall
+    clock is never read twice for the same expectation: this machine's clock
+    demonstrably jumps tens of seconds mid-run, which would otherwise decide
+    which half of a rule fires.
+    """
+
+    #: 2026-09-19T00:00:00Z -- fixed, arithmetic-only time base for all cases.
+    ANCHOR = datetime(2026, 9, 19, 0, 0, 0, tzinfo=timezone.utc)
+
+    @classmethod
+    def at(cls, offset_seconds: float) -> str:
+        return rfc3339_z(cls.ANCHOR + timedelta(seconds=offset_seconds))
+
+    def setUp(self) -> None:
+        from cryptography.hazmat.primitives import serialization
+        from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
+
+        self._env_backup: dict[str, str | None] = {}
+        for name in (
+            ap.PROVIDER_ENV_VAR,
+            ap.TRUST_DOMAIN_ENV_VAR,
+            ap.TIMEOUT_ENV_VAR,
+            ap.STDOUT_LIMIT_ENV_VAR,
+            ap.MAX_WINDOW_ENV_VAR,
+            "I08B_FAKE_LOG",
+        ):
+            self._env_backup[name] = os.environ.get(name)
+            os.environ.pop(name, None)
+        self._fake_backup = {
+            name: value
+            for name, value in os.environ.items()
+            if name.startswith("I08B_FAKE_")
+        }
+        for name in list(self._fake_backup):
+            os.environ.pop(name, None)
+
+        self._temporary = tempfile.TemporaryDirectory()
+        self.tmp = Path(self._temporary.name)
+        self.provider_log = self.tmp / "provider_calls.jsonl"
+        self._provider_args: list[str] = []
+
+        self.private_key = Ed25519PrivateKey.generate()
+        self.private_hex = self.private_key.private_bytes(
+            encoding=serialization.Encoding.Raw,
+            format=serialization.PrivateFormat.Raw,
+            encryption_algorithm=serialization.NoEncryption(),
+        ).hex()
+        self.public_bytes = self.private_key.public_key().public_bytes(
+            encoding=serialization.Encoding.Raw,
+            format=serialization.PublicFormat.Raw,
+        )
+        self.fingerprint = hashlib.sha256(self.public_bytes).hexdigest()[:32]
+
+        # budget parameters: explicit TEST values, never specification values
+        os.environ[ap.TIMEOUT_ENV_VAR] = str(TIMEOUT_S)
+        os.environ[ap.STDOUT_LIMIT_ENV_VAR] = str(LIMIT_BYTES)
+        os.environ[ap.MAX_WINDOW_ENV_VAR] = str(W_TEST)
+        os.environ["I08B_FAKE_LOG"] = str(self.provider_log)
+
+    def tearDown(self) -> None:
+        for name, value in self._env_backup.items():
+            os.environ.pop(name, None)
+            if value is not None:
+                os.environ[name] = value
+        for name in list(os.environ):
+            if name.startswith("I08B_FAKE_"):
+                os.environ.pop(name, None)
+        self._temporary.cleanup()
+
+    # -- trust domain ------------------------------------------------------
+    def trust_domain_document(self, **overrides) -> dict:
+        entry = {
+            "name": "i08b-test-signer",
+            "public_key": base64.b64encode(self.public_bytes).decode("ascii"),
+            "fingerprint": self.fingerprint,
+            "issuer": ISSUER,
+            "key_id": KEY_ID,
+            "algorithm": "ed25519",
+            "environment": "production",
+            "not_before": self.at(-1000000),
+            "not_after": self.at(1000000),
+            "status": "active",
+            "revoked_at": None,
+        }
+        entry.update(overrides.pop("entry", {}))
+        document = {
+            "trust_domain_schema_version": "1.0",
+            "domain_separator": DOMAIN_SEPARATOR,
+            "public_keys": [entry],
+        }
+        document.update(overrides)
+        return document
+
+    def write_trust_domain(self, document: dict | None = None, *, raw: str | None = None) -> Path:
+        path = self.tmp / "trust_domain.json"
+        text = raw if raw is not None else json.dumps(document, indent=1)
+        path.write_text(text, encoding="utf-8")
+        os.environ[ap.TRUST_DOMAIN_ENV_VAR] = str(path)
+        return path
+
+    def install_valid_domain(self, **overrides) -> Path:
+        return self.write_trust_domain(self.trust_domain_document(**overrides))
+
+    # -- provider ----------------------------------------------------------
+    def use_fake_provider(self, mode: str = "ok", **env: str) -> None:
+        """Point the provider at an executable that speaks the protocol.
+
+        The provider is ``<test interpreter> <fake script>``: on Windows a bare
+        ``.py`` path is not executable by the OS at all, so "a real executable
+        that implements the protocol" is the interpreter plus a script argument.
+        The bare-``.py``/``.txt`` cases are covered separately (they must never be
+        considered capability, and are never spawned).
+
+        ``signed_at`` is pinned to the anchor so every timing expectation is pure
+        arithmetic (the default would be the provider's own clock reading).
+        """
+        os.environ[ap.PROVIDER_ENV_VAR] = sys.executable
+        # also configure the production argv route, so a case that goes through the
+        # real funnel does not depend on harness-only plumbing
+        os.environ[ap.PROVIDER_ARGV_ENV_VAR] = json.dumps([str(FAKE_PROVIDER)])
+        self._provider_args = [str(FAKE_PROVIDER)]
+        os.environ["I08B_FAKE_KEY_HEX"] = self.private_hex
+        os.environ["I08B_FAKE_ISSUER"] = ISSUER
+        os.environ["I08B_FAKE_KEY_ID"] = KEY_ID
+        os.environ["I08B_FAKE_MODE"] = mode
+        # The provider stamp is an OFFSET from the request's issued_at.  An
+        # explicit offset already staged by the test wins, so helper calls cannot
+        # silently overwrite the stamp a timing case depends on.
+        if "signed_at_offset" not in env:
+            os.environ.setdefault("I08B_FAKE_SIGNED_AT", "+1")
+        for name, value in env.items():
+            os.environ[f"I08B_FAKE_{name.upper()}"] = str(value)
+
+    def provider_argv(self) -> list[str]:
+        return list(self._provider_args)
+
+    def provider_calls(self) -> int:
+        """How many provider INVOCATIONS happened (each call logs two entries)."""
+        if not self.provider_log.exists():
+            return 0
+        calls = 0
+        for line in self.provider_log.read_text(encoding="utf-8").splitlines():
+            if not line.strip():
+                continue
+            try:
+                entry = json.loads(line)
+            except ValueError:  # pragma: no cover - defensive
+                continue
+            if entry.get("call") is True:
+                calls += 1
+        return calls
+
+    # -- request / call / record plumbing ----------------------------------
+    def make_request(self, **overrides) -> dict:
+        gates = tuple(overrides.pop("gate_ids", GATES))
+        issued = overrides.pop("issued_at", self.at(0))
+        expires = overrides.pop("expires_at", self.at(600))
+        request = build_request(
+            request_id=os.urandom(32).hex(),
+            issued_at=issued,
+            expires_at=expires,
+            payload_sha256=hashlib.sha256(b"payload").hexdigest(),
+            input_sha256=hashlib.sha256(b"input").hexdigest(),
+            result_sha256="",
+            receipt_sha256="",
+            requested_issuer=ISSUER,
+            gate_ids=gates,
+        )
+        request.update(overrides)
+        return request
+
+    def raw_call(self, request: dict, *, timeout: float = TIMEOUT_S, limit: int = LIMIT_BYTES):
+        return call_provider(
+            request,
+            timeout_seconds=timeout,
+            stdout_limit_bytes=limit,
+            extra_argv=self.provider_argv(),
+        )
+
+    def payload_for(self, **request_overrides) -> tuple[dict, dict]:
+        """Isolated domain + provider + one raw handshake, returning its payload.
+
+        ``signed_at_offset`` is the provider stamp expressed as seconds relative to
+        the request's own ``issued_at``; it is staged BEFORE the provider helper
+        runs so an explicit stamp can never be overwritten by the default.
+        """
+        offset = request_overrides.pop("signed_at_offset", None)
+        self.install_valid_domain()
+        if offset is not None:
+            os.environ["I08B_FAKE_SIGNED_AT"] = str(offset)
+        self.use_fake_provider()
+        request = self.make_request(**request_overrides)
+        result = self.raw_call(request)
+        self.assertTrue(
+            result.ok, f"provider call failed: {result.code} {result.detail}"
+        )
+        response = ap.validate_response(result.response, request)
+        return request, ap.response_to_payload(
+            response, request, gate_ids=tuple(request["gate_ids"])
+        )
+
+    def real_outcome(self, **overrides):
+        """Call the production funnel so the env-configured T/L and argv are used.
+
+        ``provider_argv`` is deliberately NOT passed: the production path reads the
+        argv tail from ``REVENUE_ATTESTATION_PROVIDER_ARGV``, so leaving it out is
+        what makes this case exercise the real configuration route.
+        """
+        return ap.attest_publication(
+            payload_sha256=hashlib.sha256(b"payload").hexdigest(),
+            input_sha256=hashlib.sha256(b"input").hexdigest(),
+            result_sha256="",
+            receipt_sha256="",
+            gate_ids=GATES,
+            requested_issuer=ISSUER,
