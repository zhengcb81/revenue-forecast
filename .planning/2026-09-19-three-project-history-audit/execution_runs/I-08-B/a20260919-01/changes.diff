+        # environment, so both must be configured here (this harness also drives
+        # `call_provider` directly with extra_argv, which is a second route)
+        os.environ[ap.PROVIDER_ENV_VAR] = sys.executable
+        os.environ[ap.PROVIDER_ARGV_ENV_VAR] = json.dumps([str(FAKE_PROVIDER)])
+        self.assertEqual(
+            ap.provider_extra_argv(),
+            [str(FAKE_PROVIDER)],
+            "the env argv tail must be what the production path would use",
+        )
