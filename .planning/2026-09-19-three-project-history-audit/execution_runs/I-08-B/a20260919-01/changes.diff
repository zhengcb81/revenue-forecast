+"""Isolated BOUNDED fake attestation provider for the I-08-B protocol tests.
+
+This file lives in the attempt's isolated copy only.  It is never installed, never
+on PATH and never referenced by production configuration; the tests pass its
+absolute path through ``REVENUE_ATTESTATION_PROVIDER``.
+
+Protocol (frozen by I-08-A decision.md section 2): read one JSON request object
+from stdin, write one JSON response object to stdout, exit 0.  Faults are injected
+through the environment so a single script can express every negative case:
+
+  I08B_FAKE_KEY_HEX     raw Ed25519 private key (32 bytes hex) -- in-process only
+  I08B_FAKE_ISSUER      issuer to declare
+  I08B_FAKE_KEY_ID      key_id to declare
+  I08B_FAKE_FINGERPRINT optional override of the reported fingerprint
+  I08B_FAKE_ALGORITHM   default "ed25519"
+  I08B_FAKE_MODE        ok | not_json | trailing | exit_nonzero | exit_code |
+                        schema_missing | schema_extra | schema_badtype |
+                        signing_unavailable | bad_signature_hex | bad_fingerprint |
+                        bad_signed_at | sleep | empty
+                        (also accepted as the first command-line argument)
+  I08B_FAKE_MUTATE_ECHO field name to corrupt after building the response
+                        (request_id | payload_sha256 | domain_separator)
+  I08B_FAKE_PAD_BYTES   pad the declared issuer with N filler bytes (L tests)
+  I08B_FAKE_EXIT_CODE   exit code for mode=exit_code (default 1)
+  I08B_FAKE_SLEEP_S     seconds to sleep for mode=sleep
+  I08B_FAKE_LOG         append one JSON line per call (request/response witness)
+
+The private key is passed through the environment of this child process only.  It
+is never written to a trust-domain file, never printed, and never logged.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import sys
+import time
+
+PROTOCOL_DIR = os.path.abspath(
+    os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "scripts")
+)
+if PROTOCOL_DIR not in sys.path:
+    sys.path.insert(0, PROTOCOL_DIR)
+
+from attestation_protocol import REQUEST_FIELDS, RESPONSE_FIELDS  # noqa: E402
+
+
+def _log(entry: dict) -> None:
+    path = os.environ.get("I08B_FAKE_LOG")
+    if not path:
+        return
+    try:
+        with open(path, "a", encoding="utf-8") as handle:
+            handle.write(json.dumps(entry, sort_keys=True) + "\n")
+    except OSError:  # pragma: no cover - logging must never mask the protocol
+        pass
+
+
+def _sign(key_hex: str, payload: dict) -> str:
+    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
+
+    private = Ed25519PrivateKey.from_private_bytes(bytes.fromhex(key_hex))
+    body = json.dumps(
+        payload, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False
+    ).encode("utf-8")
+    return private.sign(hashlib.sha256(body).hexdigest().encode("ascii")).hex()
+
+
+def main(argv: list[str]) -> int:
+    # The mode comes from the ENVIRONMENT, never from argv: the production
+    # protocol passes nothing on the command line, so the negative cases must be
+    # injectable without inventing a CLI.
+    mode = os.environ.get("I08B_FAKE_MODE", "ok").strip()
+    raw = sys.stdin.read() if not sys.stdin.isatty() else ""
+    if mode == "sleep":
+        time.sleep(float(os.environ.get("I08B_FAKE_SLEEP_S", "5")))
+    try:
+        request = json.loads(raw) if raw.strip() else {}
+    except ValueError:
+        request = {}
+    _log({"call": True, "mode": mode, "request": request, "stdout_cap_hint": True})
+
+    if mode == "empty":
+        return 0
+    if mode == "exit_nonzero":
+        sys.stdout.write("")
+        return 1
+    if mode == "exit_code":
+        return int(os.environ.get("I08B_FAKE_EXIT_CODE", "1"))
+    if mode == "not_json":
+        sys.stdout.write("this is not json at all")
+        return 0
+    if mode == "trailing":
+        sys.stdout.write(json.dumps({"a": 1}) + " trailing garbage")
+        return 0
+    if mode == "signing_unavailable":
+        sys.stdout.write(json.dumps({"error": "signing_unavailable"}))
+        return 0
+
+    key_hex = os.environ.get("I08B_FAKE_KEY_HEX", "")
+    issuer = os.environ.get("I08B_FAKE_ISSUER", "revenue-forecast/host-a")
+    pad = int(os.environ.get("I08B_FAKE_PAD_BYTES", "0") or 0)
+    if pad:
+        issuer = issuer + ("x" * pad)
+    key_id = os.environ.get("I08B_FAKE_KEY_ID", "rf-test-2026a")
+    algorithm = os.environ.get("I08B_FAKE_ALGORITHM", "ed25519")
+    fingerprint = os.environ.get("I08B_FAKE_FINGERPRINT", "")
+    if not fingerprint and key_hex:
+        from cryptography.hazmat.primitives import serialization
+        from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
+
+        private = Ed25519PrivateKey.from_private_bytes(bytes.fromhex(key_hex))
+        raw_public = private.public_key().public_bytes(
+            encoding=serialization.Encoding.Raw,
+            format=serialization.PublicFormat.Raw,
+        )
+        fingerprint = hashlib.sha256(raw_public).hexdigest()[:32]
+
+    # signed_at is ALWAYS expressed relative to the request's own issued_at, so a
+    # case controls the offset while remaining valid for whatever window the host
+    # chose.  An absolute stamp would not fit a live-clock window, and the two
+    # would then be judged by different clocks.
+    raw_offset = os.environ.get("I08B_FAKE_SIGNED_AT", "").strip() or "+1"
+    try:
+        from datetime import datetime, timedelta, timezone
+
+        base = datetime.strptime(
+            request.get("issued_at", "2026-09-19T00:00:00Z"), "%Y-%m-%dT%H:%M:%SZ"
+        ).replace(tzinfo=timezone.utc)
+        signed_at = (base + timedelta(seconds=int(raw_offset))).strftime(
+            "%Y-%m-%dT%H:%M:%SZ"
+        )
+    except (ValueError, TypeError):
+        # not an offset: use it literally (or fall back to issued_at itself)
+        signed_at = raw_offset if raw_offset else request.get("issued_at", "")
+    if mode == "bad_signed_at":
+        signed_at = "not-a-timestamp"
+
+    payload = {
+        "attestation_payload_schema_version": "1.0",
+        "domain_separator": request.get("domain_separator", ""),
+        "issuer": issuer,
+        "key_id": key_id,
+        "key_fingerprint": fingerprint,
+        "algorithm": algorithm,
+        "request_id": request.get("request_id", ""),
+        "issued_at": request.get("issued_at", ""),
+        "expires_at": request.get("expires_at", ""),
+        "signed_at": signed_at,
+        "input_sha256": request.get("input_sha256", ""),
+        "payload_sha256": request.get("payload_sha256", ""),
+        "result_sha256": request.get("result_sha256", ""),
+        "receipt_sha256": request.get("receipt_sha256", ""),
+        "engine_version": request.get("engine_version", ""),
+        "forecast_schema_version": request.get("forecast_schema_version", ""),
+        "publication_receipt_schema_version": request.get(
+            "publication_receipt_schema_version", ""
+        ),
+        "validator_version": request.get("engine_version", ""),
+        "gate_ids": list(request.get("gate_ids", []) or []),
+    }
+    response = {
+        "attestation_response_schema_version": "1.0",
+        "request_id": payload["request_id"],
+        "payload_sha256": payload["payload_sha256"],
+        "domain_separator": payload["domain_separator"],
+        "issuer": issuer,
+        "key_id": key_id,
+        "key_fingerprint": fingerprint,
+        "signature_algorithm": algorithm,
+        "signature": _sign(key_hex, payload) if key_hex else "0" * 128,
+        "signed_at": signed_at,
+    }
+
+    mutate = os.environ.get("I08B_FAKE_MUTATE_ECHO", "")
+    if mutate == "request_id":
+        response["request_id"] = "f" * 64
+    elif mutate == "payload_sha256":
+        response["payload_sha256"] = "e" * 64
+    elif mutate == "domain_separator":
+        response["domain_separator"] = "revenue-forecast/other-service/v1"
+
+    if mode == "schema_missing":
+        response.pop("key_id")
+    elif mode == "schema_extra":
+        response["unexpected_field"] = "extra"
+    elif mode == "schema_badtype":
+        response["gate_ids_typo"] = 0
+        response.pop("signature_algorithm")
+    elif mode == "bad_signature_hex":
+        response["signature"] = "A" * 128
+    elif mode == "bad_fingerprint":
+        response["key_fingerprint"] = "ZZ"
+
+    missing = [field for field in RESPONSE_FIELDS if field not in response]
+    extra = [field for field in response if field not in RESPONSE_FIELDS]
+    _log(
+        {
+            "response": response,
+            "missing_fields": missing,
+            "extra_fields": extra,
+            "request_fields_ok": sorted(request) == sorted(REQUEST_FIELDS)
+            or set(request) == set(REQUEST_FIELDS),
+        }
+    )
+    try:
+        sys.stdout.write(json.dumps(response, ensure_ascii=False, sort_keys=True))
+    except (BrokenPipeError, OSError):  # pragma: no cover - host went away
+        return 0
+    try:
+        sys.stdout.flush()
+    except (BrokenPipeError, OSError):  # pragma: no cover
+        return 0
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv))
