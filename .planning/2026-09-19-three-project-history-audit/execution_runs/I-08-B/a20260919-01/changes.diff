+    def test_tn28_issued_before_signed_inside_window_passes(self) -> None:
+        """The INCLUSIVE half of the E18 window rule, on one anchored timeline.
+
+        The provider stamps ``issued_at + 601s``; with the request window
+        [A+600, A+1200] the stamp lands strictly inside it, so validation passes.
+        """
+        _, payload = self.payload_for(
+            issued_at=self.at(600), expires_at=self.at(1800), signed_at_offset=601
+        )
+        self.assertEqual(
+            payload["signed_at"],
+            self.at(1201),
+            msg=(
+                f"signed_at={payload['signed_at']} issued={payload['issued_at']} "
+                f"expires={payload['expires_at']} "
+                f"env={os.environ.get('I08B_FAKE_SIGNED_AT')}"
+            ),
+        )
+        self.assertGreater(
+            ap.parse_utc(payload["signed_at"], "signed_at"),
+            ap.parse_utc(payload["issued_at"], "issued_at"),
+        )
+        self.assertLess(
+            ap.parse_utc(payload["signed_at"], "signed_at"),
+            ap.parse_utc(payload["expires_at"], "expires_at"),
+        )
+        ap.validate_payload(payload)  # inside the window: no violation
