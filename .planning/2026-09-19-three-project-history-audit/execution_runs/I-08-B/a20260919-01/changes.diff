+class E30InputBindingTests(unittest.TestCase):
+    """E30 ``input_binding_mismatch`` must be raised, not merely described.
+
+    The independent review measured that the code appeared ONLY as constant
+    definitions and docstrings: the pre-existing gate
+    (``trust_anchor.verify_input_binding``) refused correctly but reported a bare
+    prose message with no code.  It now raises through
+    :class:`attestation_protocol.AttestationError` with the code attached, while the
+    historical message texts stay VERBATIM (the design requires exactly that).
+    """
+
+    def setUp(self) -> None:
+        from contracts.evidence import canonical_sha256
+
+        self.canonical_sha256 = canonical_sha256
+
+    def assert_code(self, expected: str, callable_, *args, **kwargs):
+        with self.assertRaises(AttestationError) as ctx:
+            callable_(*args, **kwargs)
+        self.assertEqual(
+            ctx.exception.code,
+            expected,
+            f"expected {expected}, got {ctx.exception.code} ({ctx.exception})",
+        )
+        # the code is reported AND the historical prose survives
+        self.assertIn(ap.E30_INPUT_BINDING_MISMATCH, str(ctx.exception))
+        return ctx.exception
+
+    def test_e30_missing_anchor(self) -> None:
+        from trust_anchor import verify_input_binding
+
+        error = self.assert_code(
+            ap.E30_INPUT_BINDING_MISMATCH, verify_input_binding, {"result": 1}
+        )
+        self.assertIn("input binding mismatch", str(error))
+
+    def test_e30_embedded_document_does_not_hash_to_the_anchor(self) -> None:
+        from trust_anchor import verify_input_binding
+
+        document = {"company_name": "tampered"}
+        result = {
+            "input_sha256": self.canonical_sha256({"company_name": "original"}),
+            "input_document": document,
+        }
+        error = self.assert_code(
+            ap.E30_INPUT_BINDING_MISMATCH, verify_input_binding, result
+        )
+        self.assertIn(
+            "embedded input_document does not hash to input_sha256", str(error)
+        )
+
+    def test_e30_validated_input_does_not_hash_to_the_anchor(self) -> None:
+        from trust_anchor import verify_input_binding
+
+        original = {"company_name": "original"}
+        result = {"input_sha256": self.canonical_sha256(original)}
+        error = self.assert_code(
+            ap.E30_INPUT_BINDING_MISMATCH,
+            verify_input_binding,
+            result,
+            {"company_name": "other"},
+        )
+        self.assertIn("validated input does not hash to input_sha256", str(error))
+
+    def test_e30_is_a_forecast_input_error_for_existing_callers(self) -> None:
+        """The code is additive: every existing ``except ForecastInputError`` works."""
+        from contracts.evidence import ForecastInputError
+        from trust_anchor import verify_input_binding
+
+        with self.assertRaises(ForecastInputError):
+            verify_input_binding({"result": 1})
+
+    def test_matching_anchor_passes(self) -> None:
+        from trust_anchor import verify_input_binding
+
+        document = {"company_name": "original"}
+        verify_input_binding(
+            {
+                "input_sha256": self.canonical_sha256(document),
+                "input_document": document,
+            },
+            document,
+        )
+
+
+class ProjectionCoverageTests(unittest.TestCase):
+    """P2-2: the attestation commitment must cover the artifact's own content.
+
+    The independent review measured that ``sources``, ``parameter_trace``,
+    ``data_gaps`` and ``disconfirming_indicators`` could each be changed WITHOUT
+    producing an attestation finding (only ``validate_publication_receipt`` caught
+    it).  The projection is now all-inclusive apart from the fields that cannot be
+    covered, and this test pins that by name.
+    """
+
+    COVERED_KEYS = (
+        "sources",
+        "parameter_trace",
+        "data_gaps",
+        "disconfirming_indicators",
+        "input_sha256",
+        "schema_version",
+        "forecast_version",
+    )
+    UNCAPPABLE_KEYS = (
+        "result_sha256",
+        "publication_receipt",
+        "publication_attestation",
+        "publication_attestation_outcome",
+    )
+
+    def test_every_content_key_changes_the_commitment(self) -> None:
+        baseline = {key: "original" for key in self.COVERED_KEYS}
+        reference = ap.payload_sha256(baseline)
+        for key in self.COVERED_KEYS:
+            with self.subTest(key=key):
+                changed = {**baseline, key: "changed"}
+                self.assertNotEqual(
+                    ap.payload_sha256(changed),
+                    reference,
+                    f"{key} is NOT covered by the attestation commitment",
+                )
+
+    def test_the_uncappable_keys_do_not_change_the_commitment(self) -> None:
+        baseline = {key: "original" for key in self.COVERED_KEYS}
+        reference = ap.payload_sha256(baseline)
+        for key in self.UNCAPPABLE_KEYS:
+            with self.subTest(key=key):
+                changed = {**baseline, key: {"anything": True}}
+                self.assertEqual(
+                    ap.payload_sha256(changed),
+                    reference,
+                    f"{key} changed the commitment although it cannot be covered",
+                )
+
+    def test_the_commitment_matches_the_receipt_projection(self) -> None:
+        """Both hashes must come from ONE implementation, or they can drift."""
+        from revenue_publication import _payload_sha256
+
+        artifact = {key: "original" for key in self.COVERED_KEYS}
+        self.assertEqual(_payload_sha256(artifact), ap.payload_sha256(artifact))
+
+
+if __name__ == "__main__":
+    unittest.main()
