+    def test_tn27_issued_at_after_signed_at(self) -> None:
+        # The provider stamps signed_at = issued_at + 1s, so the issued<=signed
+        # half of the rule cannot be broken from the request side.  Break it on
+        # the signed payload itself: move issued_at after signed_at and re-sign,
+        # which is exactly the "pre-signed blank credential" shape the rule exists
+        # to reject.
+        self.install_valid_domain()
+        record = self.signed_record()
+        forged = self.re_record(record, {"issued_at": self.at(60)})
+        payload = ap.record_to_payload(forged)
+        self.assertGreater(
+            ap.parse_utc(payload["issued_at"], "issued_at"),
+            ap.parse_utc(payload["signed_at"], "signed_at"),
+        )
+        self.assertLess(
+            ap.parse_utc(payload["signed_at"], "signed_at"),
+            ap.parse_utc(payload["expires_at"], "expires_at"),
+        )
+        self.assert_code(ap.E18_ATTESTATION_EXPIRED_AT_PUBLISH, ap.validate_payload, payload)
