+
+#: A refusal that is NOT an E-code: OPEN-D7 has not fixed T/L yet, so the honest
+#: behaviour is to refuse the call rather than invent a budget.  It is spelled out
+#: (not ``E##``) so it can never be mistaken for a normative code.
+BUDGET_UNSPECIFIED = "provider_call_budget_unspecified"
+
+
+#: Additive, non-trust-bearing result keys that are excluded from the signed
+#: payload projection.  They record what the signing attempt DID (which provider
+#: code fired, how many calls happened, whether W was enforced) and are only known
+#: after the attempt, so no signature can honestly cover them.  Excluding them
+#: keeps the commitment stable and self-reference-free; nothing trust-bearing lives
+#: here -- the trust decision is the signed record itself.
+UNSIGNED_APPENDIX_KEYS: frozenset[str] = frozenset(
+    {"publication_attestation_outcome"}
+)
+
+
+class AttestationError(ForecastInputError):
+    """An attestation failure carrying exactly one frozen error code.
+
+    ``code`` is always a value of :data:`ERROR_CODES` (or
+    :data:`BUDGET_UNSPECIFIED` for the OPEN-D7 refusal).
+    """
+
+    def __init__(self, code: str, message: str = "") -> None:
+        self.code = code
+        self.detail = message
+        super().__init__(f"{code}: {message}" if message else code)
+
