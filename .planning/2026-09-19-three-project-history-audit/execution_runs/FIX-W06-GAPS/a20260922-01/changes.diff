+def _load_trust_root(path: str | None) -> dict[str, bytes]:
+    """key_id -> raw ed25519 public key bytes; empty when unestablished."""
+    if path is None:
+        path = os.environ.get("PROMPT_INJECTION_TRUST_ROOT")
