+def counter_totals(spy_dir: Path) -> dict:
+    ev = spy_dir / "events.jsonl"
+    if not ev.is_file():
+        return {}
+    totals: dict = {}
+    for line in ev.read_text(encoding="utf-8").splitlines():
+        if not line.strip():
+            continue
+        try:
+            name = json.loads(line).get("counter")
+        except json.JSONDecodeError:
+            continue
+        totals[name] = totals.get(name, 0) + 1
+    return totals
