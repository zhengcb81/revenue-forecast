+                    "source_id": row["source_id"],
+                    "document_id": row["document_id"],
+                    "location_id": row["location_id"],
+                    "root_id": row["root_id"],
+                    "relative_path": row["relative_path"],
+                    "role": row["role"],
+                }
+            )
+        else:
+            results.append(
+                {
+                    "content_sha256": content_sha256,
+                    "registered": False,
+                    "reason": "target_not_registered",
+                    "source_id": None,
+                    "document_id": None,
+                    "location_id": None,
+                    "root_id": None,
+                    "relative_path": None,
+                    "role": None,
+                }
+            )
