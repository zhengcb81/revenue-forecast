```diff
--- iso/baseline/authorization.py	2026-09-19 18:57:19.847176600 +0100
+++ iso/override/authorization.py	2026-09-19 19:04:13.249954200 +0100
@@ -18,6 +18,15 @@
 
 The clock is injected as a string parameter (frozen test clock); no
 production code is modified: this file is an iso attempt copy.
+
+I-03-D adds ONLY the in-stream budget boundary (plan/quota edge): a
+candidate with an UNKNOWN remote_size (``None``) is not pre-refused at
+plan level per frozen policy (the "+size <= cap" receipt check counts
+it as 0); the actual byte budget is enforced inside the stream via
+``validate_stream_budget`` — cumulative RECEIVED bytes (faithfully
+recorded, including the chunk that pushes past the cap) drive the stop;
+no qualified handle / commit is produced on over-receipt, and a single
+oversized chunk is recorded separately via ``over_cap``.
 """
 
 from __future__ import annotations
@@ -206,3 +215,23 @@
     if bytes_already_fetched + size > authorization.max_bytes:
         return "byte cap exceeded"
     return None
+
+
+def validate_stream_budget(
+    *,
+    cumulative_bytes: int,
+    chunk_bytes: int,
+    max_bytes: int,
+) -> tuple[bool, int]:
+    """I-03-D in-stream budget edge. Returns ``(over_cap, cumulative)``.
+
+    The chunk that pushes the cumulative RECEIVED bytes past the cap IS
+    recorded first (the physical received byte count is truth: never
+    claim "more than max_bytes was never physically received"); the
+    caller must stop the stream after this chunk and refuse the commit.
+    A chunk that singly exceeds the cap is visible via over_cap on the
+    >max_bytes chunk record."""
+    if chunk_bytes < 0 or cumulative_bytes < 0 or max_bytes <= 0:
+        raise ValueError("stream budget inputs must be non-negative / positive cap")
+    cumulative = cumulative_bytes + chunk_bytes
+    return cumulative > max_bytes, cumulative
```

