+"""I-04-D stub "company-wiki worker" CLI.
+
+This is NOT the real worker and never touches a real catalog.  It stands in for
+``python -m company_wiki.source_catalog.cli worker-status|worker-pause|worker-resume``
+so that a *real* subprocess boundary exists between the code under test and the
+worker side: the counters in the journal are therefore cross-process facts, not
+values the code under test reports about itself.
+
+State: one JSON file  {"desired_state": ..., "runtime_state": ...}
+Journal: one JSON line per invocation, appended (single <=4KiB write, O_APPEND).
+
+Environment:
+  I04D_WORKER_STATE     required: state file
+  I04D_WORKER_JOURNAL   required: journal file
+  I04D_WORKER_POLICY    optional: JSON {subcommand: {"fail": bool, "delay": float,
+                        "exit": int}}.  ``delay`` happens AFTER the effects are
+                        applied, which is how a resume timeout is produced.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import sys
+import time
+
+DEFAULT_STATE = {"desired_state": "enabled", "runtime_state": "running"}
+
+
+def _read_state(path: Path) -> dict:
+    try:
+        payload = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return dict(DEFAULT_STATE)
+    if not isinstance(payload, dict):
+        return dict(DEFAULT_STATE)
+    return payload
+
+
+def _write_state(path: Path, payload: dict) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_name(path.name + f".{os.getpid()}.tmp")
+    tmp.write_text(json.dumps(payload, ensure_ascii=False, sort_keys=True), encoding="utf-8")
+    tmp.replace(path)
+
+
+def _journal(path: Path, record: dict) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    line = (json.dumps(record, ensure_ascii=False, sort_keys=True) + "\n").encode("utf-8")
+    handle = os.open(str(path), os.O_APPEND | os.O_CREAT | os.O_WRONLY, 0o644)
+    try:
+        os.write(handle, line)
+    finally:
+        os.close(handle)
+
+
+def _policy() -> dict:
+    raw = os.environ.get("I04D_WORKER_POLICY")
+    if not raw:
+        return {}
+    try:
+        payload = json.loads(raw)
+    except ValueError:
+        return {}
+    return payload if isinstance(payload, dict) else {}
+
+
+def main(argv: list[str]) -> int:
+    subcommand = argv[1] if len(argv) > 1 else ""
+    state_path = Path(os.environ.get("I04D_WORKER_STATE") or "worker_state.json")
+    journal_path = Path(os.environ.get("I04D_WORKER_JOURNAL") or "worker_journal.jsonl")
+    policy = _policy().get(subcommand, {}) or {}
+    state = _read_state(state_path)
+    started = time.monotonic()
+    result = "ok"
+
+    if subcommand == "worker-status":
+        pass
+    elif subcommand == "worker-pause":
+        state["desired_state"] = "paused"
+        state["runtime_state"] = "stopped"
+    elif subcommand == "worker-resume":
+        state["desired_state"] = "enabled"
+        state["runtime_state"] = "running"
+    else:
+        result = "unknown_subcommand"
+    if result == "ok" and not policy.get("fail"):
+        _write_state(state_path, state)
+    elif policy.get("fail"):
+        result = "refused"
+
+    _journal(
+        journal_path,
+        {
+            "event": "fake_worker_invocation",
+            "subcommand": subcommand,
+            "argv": argv[1:],
+            "pid": os.getpid(),
+            "ppid": os.getppid(),
+            "result": result,
+            "desired_state": state.get("desired_state"),
+            "runtime_state": state.get("runtime_state"),
+            "monotonic": round(time.monotonic(), 6),
+            "elapsed": round(time.monotonic() - started, 6),
+        },
+    )
+
+    delay = float(policy.get("delay") or 0.0)
+    if delay > 0:
+        time.sleep(delay)
+
+    exit_code = int(policy.get("exit") or 0)
+    if policy.get("fail"):
+        payload = {
+            "status": "error",
+            "error_type": result,
+            "action": subcommand,
+            "desired_state": state.get("desired_state"),
+            "runtime_state": state.get("runtime_state"),
+        }
+        sys.stderr.write(json.dumps({"error_type": "fatal", "action": subcommand}) + "\n")
+        sys.stderr.flush()
+        print(json.dumps(payload), flush=True)
+        return exit_code or 1
+
+    payload = {
+        "status": "ok",
+        "action": subcommand,
+        "desired_state": state.get("desired_state"),
+        "runtime_state": state.get("runtime_state"),
+    }
+    print(json.dumps(payload), flush=True)
+    return exit_code
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv))
