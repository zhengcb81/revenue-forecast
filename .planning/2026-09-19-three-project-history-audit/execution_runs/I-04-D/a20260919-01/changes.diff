+def _impl_supports_hooks() -> bool:
+    """Whether the code under test exposes the I-04-D crash/gate instrumentation."""
+    text = (SCRIPTS / "fetch_filing.py").read_text(encoding="utf-8", errors="replace")
+    return "_i04d_hook" in text
