+"""I-04-D participant: one REAL subprocess exercising the code under test.
+
+The participant does not re-implement anything: it imports ``fetch_filing`` from
+the isolated copy and drives ``PausedWorkerScope`` for real, with the fake worker
+as a real child process.  Everything it observes goes into a report JSON that the
+scheduler (a different process) reads.
+
+Usage (from iso/filing-fetch):
+  python scripts/i04d_participant.py --case NAME --tag A --root <wiki-root> \
+      --report <path> --state <fake-worker-state> --journal <fake-worker-journal> \
+      --request-budget 900 [--hooks ...] [--nested] [--worker-enabled 0|1]
+
+Exit codes (frozen in oracle.md section 1):
+  0  returned normally (protocol correctness is judged from the report, not this)
+  2  a FilingFetchError surfaced (the report carries error_code)
+  90/91/92/93  a PLANNED crash injection fired (--hooks crash:<point>:<code>)
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import sys
+import time
+
+HERE = Path(__file__).resolve().parent
+if str(HERE) not in sys.path:
+    sys.path.insert(0, str(HERE))
+
+import fetch_filing as ff  # noqa: E402  (the code under test)
+
+
+def _sha256(path: Path) -> str:
+    try:
+        return hashlib.sha256(path.read_bytes()).hexdigest()
+    except OSError:
+        return ""
+
+
+def _snapshot(root: Path) -> dict:
+    catalog = root / ".source_catalog"
+    refcount = catalog / "filing_fetch_pause.refcount"
+    owner = catalog / "filing_fetch_pause.owner"
+    lock = catalog / "filing_fetch_pause.lock"
+    text = ""
+    payload = None
+    if refcount.exists():
+        try:
+            text = refcount.read_text(encoding="utf-8")
+            payload = json.loads(text)
+        except (OSError, ValueError):
+            text = "<unreadable>"
+    entries = []
+    if isinstance(payload, dict) and isinstance(payload.get("entries"), list):
+        entries = sorted(
+            str(e.get("lease_id")) for e in payload["entries"] if isinstance(e, dict)
+        )
+    return {
+        "refcount_exists": refcount.exists(),
+        "refcount_sha256": _sha256(refcount),
+        "refcount_text": text,
+        "lease_set": entries,
+        "generation": payload.get("generation") if isinstance(payload, dict) else None,
+        "owner": payload.get("owner") if isinstance(payload, dict) else None,
+        "resume_required": (
+            bool((payload.get("resume") or {}).get("required"))
+            if isinstance(payload, dict)
+            else None
+        ),
+        "owner_marker_exists": owner.exists(),
+        "lock_exists": lock.exists(),
+        "lock_bytes": lock.stat().st_size if lock.exists() else None,
+    }
+
+
+def main(argv: list[str]) -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--case", required=True)
+    parser.add_argument("--tag", default="p")
+    parser.add_argument("--root", required=True)
+    parser.add_argument("--report", required=True)
