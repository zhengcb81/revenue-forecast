{
 "card_id": "M10",
 "model_id": "reserve_depletion",
 "first_required_driver": "opening_reserves",
 "independent_deepcopy_per_case": true,
 "continuity_first_positive": "continuity_positive",
 "continuity_then_break_order": [
  "run continuity_positive and check it against oracle.continuity_positive",
  "only then apply the CONT-BREAK patch to a fresh deepcopy of continuity_positive"
 ],
 "cases": [
  {
   "id": "NEG-CARD",
   "kind": "set_driver",
   "driver": "closing_reserves",
   "expected": "ValueError",
   "base_input": "positive",
   "why": "card-specific negative named in the card body",
   "guard_hint": "stock-flow balance guard: 1000+100-50-200 = 850 != 851",
   "value": [
    851
   ]
  },
  {
   "id": "N01a",
   "kind": "set_driver_element",
   "driver": "opening_reserves",
   "expected": "ModelRegistryError",
   "base_input": "positive",
   "why": "common negative N01a: bool is not a numeric driver value",
   "guard_hint": "",
   "index": 0,
   "value": {
    "__bool__": true
   }
  },
  {
   "id": "N01b",
   "kind": "set_driver_element",
   "driver": "opening_reserves",
   "expected": "ModelRegistryError",
   "base_input": "positive",
   "why": "common negative N01b: non-finite value nan",
   "guard_hint": "",
   "index": 0,
   "value": {
    "__float__": "nan"
   }
  },
  {
   "id": "N01c",
   "kind": "set_driver_element",
   "driver": "opening_reserves",
   "expected": "ModelRegistryError",
   "base_input": "positive",
   "why": "common negative N01c: non-finite value inf",
   "guard_hint": "",
   "index": 0,
   "value": {
    "__float__": "inf"
   }
  },
  {
   "id": "N01d",
   "kind": "set_driver_element",
   "driver": "opening_reserves",
   "expected": "ModelRegistryError",
   "base_input": "positive",
   "why": "common negative N01d: non-finite value -inf",
   "guard_hint": "",
   "index": 0,
   "value": {
    "__float__": "-inf"
   }
  },
  {
   "id": "N02",
   "kind": "set_driver",
   "driver": "opening_reserves",
   "expected": "ModelRegistryError",
   "base_input": "positive",
   "why": "common negative N02: first required driver array is empty, so its length != len(years)",
   "guard_hint": "",
   "value": []
  },
  {
   "id": "N03",
   "kind": "delete_driver",
   "driver": "opening_reserves",
   "expected": "ModelRegistryError",
   "base_input": "positive",
   "why": "common negative N03: first required driver deleted (missing required field)",
   "guard_hint": ""
  },
  {
   "id": "N04",
   "kind": "add_driver",
   "driver": "unknown_driver",
   "expected": "ModelRegistryError",
   "base_input": "positive",
   "why": "common negative N04: unknown_driver added (unsupported driver)",
   "guard_hint": "",
   "value": [
    1
   ]
  },
  {
   "id": "N05a",
   "kind": "set_years",
   "driver": null,
   "expected": "ModelRegistryError",
   "base_input": "positive",
   "why": "common negative N05a: years = [] (fiscal-year domain)",
   "guard_hint": "",
   "value": []
  },
  {
   "id": "N05b",
   "kind": "set_years",
   "driver": null,
   "expected": "ModelRegistryError",
   "base_input": "positive",
   "why": "common negative N05b: first year replaced by True (True is not a fiscal year)",
   "guard_hint": "",
   "value": {
    "__bool__first__": true
   }
  },
  {
   "id": "CONT-BREAK",
   "kind": "set_driver_multi",
   "driver": null,
   "expected": "ModelRegistryError",
   "base_input": "continuity_positive",
   "why": "continuity break for this card (oracle.md section 4)",
   "guard_hint": "cross-year continuity guard: opening[2028]=851 != closing[2027]=850; each year balances on its own",
   "value": {
    "opening_reserves": [
     1000,
     851
    ],
    "closing_reserves": [
     850,
     851
    ]
   }
  }
 ],
 "extra_observations": [
  {
   "id": "OBS-BASE-IGNORED",
   "kind": "set_base_revenue",
   "value": 999,
   "base_input": "positive",
   "compare_to": "positive",
   "expect_equal": true,
   "why": "the reserve bridge discards base_revenue; design observation only"
  },
  {
   "id": "OBS-DEFAULT-EQUIV",
   "kind": "set_driver_multi",
   "base_input": "defaults",
   "value": {
    "other_revenue": [
     0
    ],
    "reserve_revisions": [
     0
    ]
   },
   "compare_to": "defaults",
   "expect_equal": true,
   "why": "explicit 0/0 equals the omitted optional drivers; makes the documented default falsifiable"
  },
  {
   "id": "OBS-REVISION-POS",
   "kind": "set_driver_multi",
   "base_input": "positive",
   "value": {
    "reserve_revisions": [
     50
    ],
    "closing_reserves": [
     950
    ]
   },
   "why": "a positive revision keeps the balance (1000+100+50-200=950) and must not change revenue: revisions enter the stock bridge only"
  },
  {
   "id": "OBS-RECOVERY-GT1",
   "kind": "set_driver",
   "driver": "recovery_rate",
   "value": [
    1.5
   ],
   "base_input": "positive",
   "why": "records that recovery_rate keeps the ratio default bound [0, 1] (it has no explicit driver_bounds entry)"
  }
 ]
}
