+def _basis_kind(basis) -> str:
+    """Classify a claim's basis by kind, WITHOUT hashing it.  (J16b)
+
+    The registry membership test needs a hashable value; a list or a dict is not,
+    and evaluating `basis not in BASIS_REGISTRY` on one raises
+    `TypeError: unhashable type` -- which used to abort the entire batch rather
+    than refuse the single case that carried it.  Kind is decided by type first,
+    so no unhashable value is ever hashed.
+    """
+    if isinstance(basis, str):
+        return "str"
+    if basis is None:
+        return "none"
+    if isinstance(basis, (list, tuple, set, frozenset, dict)):
+        return "container"
+    return "other"
+
+
+def _basis_repr(basis):
+    """A JSON-native echo of a basis value for the report.
+
+    Only a string passes through verbatim.  Anything else is reported as its
+    type name, so the report stays serialisable no matter what the claim carried
+    (a `set` basis would otherwise make json.dumps raise, breaking the run at the
+    WRITE step even after the verdict was decided correctly) and so no raw
+    non-string value can masquerade as a registered basis downstream.
+    """
+    return basis if isinstance(basis, str) else f"<non-string basis: {type(basis).__name__}>"
+
