+        "threshold_basis": basis,
+        "threshold_review_status_present": present,
+        "threshold_review_status_raw": raw,
+        "threshold_review_status_effective": eff,
+        "defaulted": not present,
+        "state": h.get("state"),
+        "usable": not reasons,
+        "reasons": reasons,
+    }
