            "table_index": null,
            "row_index": null,
            "column_index": null
          },
          "quality_flags": [],
          "topics": [],
          "selection_reasons": [
            "linked_question_context"
          ],
          "source_role": "analyst",
          "excerpt": "Satya, maybe I'll start away from the numbers and ask if you could spend a minute and elaborate on your opening comments about model choice and the protection of corporate IP."
        },
        {
          "span_id": "urn:company-wiki:evidence-span:sha256:3e089f7e5b136cb18eb8ab9eed9c93cae2158183754dc992d6e73c10fa9b8aeb",
          "locator_v1": "loc:v1/paragraph:235/chars:189-223",
          "coordinates": {
            "page_number": null,
            "paragraph_index": 235,
            "table_index": null,
            "row_index": null,
            "column_index": null
          },
          "quality_flags": [],
          "topics": [],
          "selection_reasons": [
            "linked_question_context"
          ],
          "source_role": "analyst",
          "excerpt": "Maybe I could ask this in 2 parts."
        },
        {
          "span_id": "urn:company-wiki:evidence-span:sha256:674f7ab55d2c813f67ccd0bb78cc1990b81becd691739af0f4739b4b8c9bede3",
          "locator_v1": "loc:v1/paragraph:235/chars:224-404",
          "coordinates": {
            "page_number": null,
            "paragraph_index": 235,
            "table_index": null,
            "row_index": null,
            "column_index": null
          },
          "quality_flags": [],
          "topics": [],
          "selection_reasons": [
            "linked_question_context"
          ],
          "source_role": "analyst",
          "excerpt": "First, how material do you think traction could be for open and custom models over the next year or 2, knowing that many enterprises might be initially reticent to use open models?"
        },
        {
          "span_id": "urn:company-wiki:evidence-span:sha256:d21f44af33725623f259bfc8169ad94c7331990329f64feefa727d4bf9b6de69",
          "locator_v1": "loc:v1/paragraph:235/chars:405-534",
          "coordinates": {
            "page_number": null,
            "paragraph_index": 235,
            "table_index": null,
            "row_index": null,
            "column_index": null
          },
          "quality_flags": [],
          "topics": [],
          "selection_reasons": [
            "linked_question_context"
          ],
          "source_role": "analyst",
          "excerpt": "And secondly, how exactly does Microsoft benefit from this shift knowing that you've also got fairly large frontier lab exposure?"
        },
        {
          "span_id": "urn:company-wiki:evidence-span:sha256:8e3eb5bd50684aeac08ba26d3735dabe0cecd675f67766a7f5d7c3d42ce74cf5",
