          "topics": [],
          "selection_reasons": [
            "linked_question_context"
          ],
          "source_role": "analyst",
          "excerpt": "Congratulations on the solid -- really great quarter."
        },
        {
          "span_id": "urn:company-wiki:evidence-span:sha256:09762e11619d47861ba1572c3db02ed438cbbf3ad68a3a4494e53afa8e1bd5e2",
