            "paragraph_index": 261,
            "table_index": null,
            "row_index": null,
            "column_index": null
          },
          "quality_flags": [],
          "topics": [],
          "selection_reasons": [
            "linked_question_context"
          ],
          "source_role": "analyst",
          "excerpt": "How does Microsoft protect itself if there really is overcapacity and overbuilding of data centers or overbuilding of chips, et cetera?"
        },
        {
          "span_id": "urn:company-wiki:evidence-span:sha256:3ddfeb351fda3d3fff66e53b679c9ea0688ecf1cd7ff784ac94b35cf77c5c73e",
          "locator_v1": "loc:v1/paragraph:261/chars:388-639",
          "coordinates": {
            "page_number": null,
            "paragraph_index": 261,
            "table_index": null,
            "row_index": null,
            "column_index": null
          },
          "quality_flags": [],
          "topics": [],
          "selection_reasons": [
            "linked_question_context"
          ],
          "source_role": "analyst",
          "excerpt": "And on the flip side of that, how do you manage through the hardware price increases that we're seeing, the component prices and that it doesn't just drive you to either massively drive up the price of your offerings or negatively impact yo"
        },
        {
          "span_id": "urn:company-wiki:evidence-span:sha256:86d9899d3690e13d4732137826f29d0cf9273bd290a2b35e0e6bf330f169662d",
          "locator_v1": "loc:v1/paragraph:261/chars:54-225",
          "coordinates": {
            "page_number": null,
            "paragraph_index": 261,
            "table_index": null,
            "row_index": null,
            "column_index": null
          },
          "quality_flags": [],
          "topics": [],
          "selection_reasons": [
            "linked_question_context"
          ],
          "source_role": "analyst",
          "excerpt": "Satya, Amy, sentiment around AI remains incredibly volatile with concerns about oversupply coming as well as concerns about component pricing increasing impacting margins."
        }
