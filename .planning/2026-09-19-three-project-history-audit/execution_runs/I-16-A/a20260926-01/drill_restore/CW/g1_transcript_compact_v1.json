          },
          "quality_flags": [],
          "topics": [],
          "selection_reasons": [
            "linked_question_context"
          ],
          "source_role": "analyst",
          "excerpt": "Great."
        },
        {
          "span_id": "urn:company-wiki:evidence-span:sha256:c6c5bab70d26c25eebefa45577d5e7d195310c85a9ea79471eb798fc18feb904",
          "locator_v1": "loc:v1/paragraph:251/chars:0-241",
          "coordinates": {
