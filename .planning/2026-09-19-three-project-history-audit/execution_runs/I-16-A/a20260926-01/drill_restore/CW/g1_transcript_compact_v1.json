          "selection_reasons": [
            "linked_question_context"
          ],
          "source_role": "analyst",
          "excerpt": "Okay."
        },
        {
          "span_id": "urn:company-wiki:evidence-span:sha256:22ba1cad79c16d2ec285d2e799fc429c24614858b72933bcc277f1d18b96b87d",
          "locator_v1": "loc:v1/paragraph:235/chars:13-188",
          "coordinates": {
            "page_number": null,
