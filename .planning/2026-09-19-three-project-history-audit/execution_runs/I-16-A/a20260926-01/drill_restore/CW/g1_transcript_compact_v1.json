          "quality_flags": [],
          "topics": [],
          "selection_reasons": [
            "linked_question_context"
          ],
          "source_role": "analyst",
          "excerpt": "Amy, 2 related questions."
        },
        {
          "span_id": "urn:company-wiki:evidence-span:sha256:e1b7f168c52b86fa31c3a6e0026cab3dc94dc87017fb91a1491d9b6d638ea2f2",
