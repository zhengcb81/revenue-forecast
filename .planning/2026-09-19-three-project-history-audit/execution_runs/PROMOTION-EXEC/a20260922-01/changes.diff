+    assert conftest.GENERATION_RESERVE == 150
+    assert conftest.BASETEMP_MAX_CHARS == conftest.WIN32_PATH_LIMIT - conftest.GENERATION_RESERVE
+    assert conftest.BASETEMP_MAX_CHARS == 60
