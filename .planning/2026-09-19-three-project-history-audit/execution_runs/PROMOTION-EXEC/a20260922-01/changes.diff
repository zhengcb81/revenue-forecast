+
+def test_constants_match_the_frozen_budget():
+    # owner §16 E-1: 「E-1: 150/60」 — reserve 150 (logon node's measured suffix; child: 125)
+    # ⇒ threshold 60. Supersedes the frozen I-14-F values 210/124/86.
