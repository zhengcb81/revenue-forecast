+assert _SPEC is not None and _SPEC.loader is not None
+conftest = importlib.util.module_from_spec(_SPEC)
+sys.modules.setdefault("cw_short_basetemp_conftest", conftest)
+_SPEC.loader.exec_module(conftest)
