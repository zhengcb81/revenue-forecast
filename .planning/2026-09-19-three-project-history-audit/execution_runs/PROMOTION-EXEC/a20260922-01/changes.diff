+        ("C:\\" + "d" * 160, "C:\\" + "d" * 160 + "\\run\\pytest", True),
+        # falsified-calibration placement: cwd 143, resolved 154 (basetemp 155/156 failed
+        # unrouted, I-14-F oracle Addendum B) → 154 > 60 ⇒ relocate
+        ("C:\\" + "n" * 140, "C:\\" + "n" * 140 + "\\run\\pytest", True),
