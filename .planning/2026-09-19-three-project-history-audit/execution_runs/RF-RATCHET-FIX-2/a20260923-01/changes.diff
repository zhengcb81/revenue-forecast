+def _resolve_paths(
+    model_id: str,
+    dimensions: Mapping[str, str],
+    optional: tuple[str, ...],
+    drivers: Mapping[str, list[float]],
+    years: Sequence[int],
+    error: type[ValueError],
+) -> dict[str, list[float]]:
+    """Reject unknown/missing driver names, then materialize each driver path."""
+    unknown = set(drivers) - set(dimensions)
+    missing = set(dimensions) - set(optional) - set(drivers)
+    if unknown or missing:
+        raise error(f"invalid drivers for {model_id}: missing={sorted(missing)}, unknown={sorted(unknown)}")
+    return {name: list(drivers.get(name, [0.0] * len(years))) for name in dimensions}
+
+
+def _validate_driver_paths(
+    model_id: str,
+    dimensions: Mapping[str, str],
+    bounds: Mapping[str, tuple[float | None, float | None]],
+    resolved: Mapping[str, list[float]],
+    years: Sequence[int],
+    error: type[ValueError],
+) -> None:
+    """Per-path length check, then per-value numeric/domain checks, in order."""
+    for name, values in resolved.items():
+        if len(values) != len(years):
+            raise error(f"driver path length mismatch: {model_id}/{name}")
+        lower, upper = bounds.get(name, (0.0, 1.0 if dimensions[name] == "ratio" else None))
+        for value in values:
+            _check_driver_numeric(model_id, name, value, error)
+            _check_driver_bounds(model_id, name, value, lower, upper, error)
+
+
+def _check_driver_numeric(
+    model_id: str, name: str, value: object, error: type[ValueError]
+) -> None:
+    """Finite-number gate; bool is rejected before the numeric check."""
+    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):
+        raise error(f"driver must be finite numeric: {model_id}/{name}")
+
+
+def _check_driver_bounds(
+    model_id: str,
+    name: str,
+    value: float,
+    lower: float | None,
+    upper: float | None,
+    error: type[ValueError],
+) -> None:
+    """Declared driver-domain gate (bounds default to [0, 1] for ratio drivers)."""
+    if (lower is not None and value < lower) or (upper is not None and value > upper):
+        raise error(f"driver out of bounds: {model_id}/{name}")
+
+
