+def _configure_output() -> None:
+    """Encoding-safe output (root-cause fix for the Windows GBK crash).
+
+    A failing step's output tail may carry characters the console codec
+    cannot encode; on a GBK stdout ``print(tail)`` then raised
+    ``UnicodeEncodeError: 'gbk' codec can't encode '\\u05a3'`` and CRASHED
+    the gate instead of reporting the step result.  Reconfigure both streams
+    to utf-8 with ``errors='replace'`` so printing child output can never
+    raise.  Return-code semantics are untouched.  Guarded: a stream that
+    cannot be reconfigured (pytest capture wrappers, closed streams) is
+    left as-is rather than raising here.
+    """
+    for stream in (sys.stdout, sys.stderr):
+        try:
+            stream.reconfigure(encoding="utf-8", errors="replace")
+        except (AttributeError, OSError, ValueError):
+            pass
+
+
 def _run(cmd: list[str], label: str, timeout: int = 600, env_extra: dict | None = None) -> int:
