@@ -0,0 +1,192 @@
+"""FC-1204 coverage lane: fail-closed / exception paths of
+``archive_retired_evidence`` (DW15-REPAIR D5 arms relocated into helpers by
+the FC-1204 deliberate split).
+
+The split moved the writer's exception arms into ``_publish``,
+``_verify_snapshot``, ``_reconcile``, ``_verify_then_publish``,
+``_snapshot_paths`` and the ``finally`` cleanup; the happy-path family never
+trips them, so they sat uncovered below the frozen 95 branch floor (85.4%).
+These tests exercise exactly those arms (the coverage gate's missing lines and
+branch arcs) without touching production behaviour and without changing any
+frozen threshold.
+"""
+
+from __future__ import annotations
+
+import gzip
+import json
+import uuid
+from datetime import datetime, timezone
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from company_wiki.source_catalog.archive_retired_evidence import (
+    ArchiveReport,
+    _publish,
+    _reconcile,
+    _verify_snapshot,
+    _verify_then_publish,
+    archive_retired_evidence,
+)
+from company_wiki.source_catalog.store import retire_document
+
+NOW = datetime(2026, 9, 22, 12, 0, tzinfo=timezone.utc)
+
+ANNUAL = """\
+第一节 释义
+
+释义：本报告使用的术语与定义说明，包括公司与关联方的界定，以及财务指标的计量口径说明。
+
+第三节 公司业务概要
+
+主营业务：公司主要从事半导体设备的研发、生产与销售，产品覆盖刻蚀、薄膜沉积、清洗等关键工艺环节。
+"""
+
+
+def _retired_catalog_for_fail_closed(tmp_path: Path):
+    import company_wiki.source_catalog as module
+
+    project = tmp_path / "project"
+    source_root = tmp_path / "sources"
+    source_root.mkdir()
+    (source_root / "a.txt").write_text(ANNUAL, encoding="utf-8")
+    catalog = module.SourceCatalog(
+        module.CatalogConfig(
+            project_root=project,
+            catalog_dir=project / ".source_catalog",
+            roots=(module.RootSpec("external", source_root, "directory"),),
+        )
+    )
+    catalog.scan()
+    catalog.normalize()
+    doc = catalog.store.fetchone("SELECT document_id FROM documents")
+    retire_document(
+        catalog.store,
+        document_id=doc["document_id"],
+        reason="test",
+        created_by="test",
+    )
+    return catalog
+
+
+def test_fcw_archive_report_to_dict_roundtrip(tmp_path):
+    catalog = _retired_catalog_for_fail_closed(tmp_path)
+    report = archive_retired_evidence(
+        catalog.config.database_path, tmp_path / "manifests", now=NOW)
+    assert isinstance(report, ArchiveReport)
+    assert report.to_dict() == dict(report.__dict__)
+
+
+def test_fcw_publish_refuses_existing_target(tmp_path):
+    tmp = tmp_path / "snap.partial"
+    tmp.write_bytes(b"x")
+    final = tmp_path / "snap.jsonl.gz"
+    final.write_bytes(b"y")
+    with pytest.raises(FileExistsError, match="already published"):
+        _publish(tmp, final)
+
+
+def test_fcw_publish_link_failure_falls_back_to_rename(tmp_path, monkeypatch):
+    def _link_fails(src, dst):
+        raise OSError("simulated hardlink failure")
+
+    monkeypatch.setattr("os.link", _link_fails)
+    tmp = tmp_path / "snap.partial"
+    tmp.write_bytes(b"x")
+    final = tmp_path / "snap.jsonl.gz"
+    _publish(tmp, final)
+    assert final.exists()
+    assert not tmp.exists()
+
+
+def test_fcw_publish_link_failure_still_refuses_raced_target(
+    tmp_path, monkeypatch
+):
+    def _link_races(src, dst):
+        Path(dst).write_bytes(b"y")   # a concurrent publish wins the race
+        raise OSError("simulated hardlink failure")
+
+    monkeypatch.setattr("os.link", _link_races)
+    tmp = tmp_path / "snap.partial"
+    tmp.write_bytes(b"x")
+    final = tmp_path / "snap.jsonl.gz"
+    with pytest.raises(FileExistsError, match="already published"):
+        _publish(tmp, final)
+
+
+def test_fcw_verify_snapshot_skips_blank_lines(tmp_path):
+    snap = tmp_path / "snap.jsonl.gz"
+    with gzip.open(snap, "wt", encoding="utf-8") as fh:
+        fh.write("\n")
+        fh.write(json.dumps({"span_id": "a", "v": 1}) + "\n")
+        fh.write("\n\n")
+        fh.write(json.dumps({"span_id": "b", "v": 2}) + "\n")
+    count, digests = _verify_snapshot(snap)
+    assert count == 2
+    assert set(digests) == {"a", "b"}
+
+
+def test_fcw_verify_snapshot_rejects_duplicate_span_ids(tmp_path):
+    snap = tmp_path / "dup.jsonl.gz"
+    with gzip.open(snap, "wt", encoding="utf-8") as fh:
+        fh.write(json.dumps({"span_id": "a", "v": 1}) + "\n")
+        fh.write(json.dumps({"span_id": "a", "v": 2}) + "\n")
+    with pytest.raises(RuntimeError, match="duplicate span_id"):
+        _verify_snapshot(snap)
+
+
+def test_fcw_archive_requires_timezone_aware_now(tmp_path):
+    catalog = _retired_catalog_for_fail_closed(tmp_path)
+    with pytest.raises(TypeError, match="timezone-aware"):
+        archive_retired_evidence(
+            catalog.config.database_path, tmp_path / "manifests",
+            now=datetime(2026, 9, 22, 12, 0))     # naive: refused (D3)
+
+
+def test_fcw_snapshot_path_collision_is_refused(tmp_path, monkeypatch):
+    catalog = _retired_catalog_for_fail_closed(tmp_path)
+    root = tmp_path / "manifests"
+    monkeypatch.setattr(uuid, "uuid4", lambda: SimpleNamespace(hex="ab" * 16))
+    first = archive_retired_evidence(
+        catalog.config.database_path, root, now=NOW)
+    assert first.ok
+    with pytest.raises(FileExistsError, match="already published"):
+        archive_retired_evidence(catalog.config.database_path, root, now=NOW)
+
+
+def test_fcw_progress_callback_is_invoked(tmp_path):
+    catalog = _retired_catalog_for_fail_closed(tmp_path)
+    calls = []
+    report = archive_retired_evidence(
+        catalog.config.database_path, tmp_path / "manifests", now=NOW,
+        progress=lambda written, total: calls.append((written, total)))
+    assert report.ok
+    assert calls and calls[-1][0] == report.rows_written
+
+
+def test_fcw_reconcile_refuses_count_mismatch():
+    with pytest.raises(RuntimeError, match="reconciliation failed"):
+        _reconcile(rows_written=3, total=4)
+
+
+def test_fcw_verify_then_publish_refuses_digest_mismatch(tmp_path):
+    snap = tmp_path / "snap.jsonl.gz"
+    with gzip.open(snap, "wt", encoding="utf-8") as fh:
+        fh.write(json.dumps({"span_id": "a", "v": 1}) + "\n")
+    out = tmp_path / "final.jsonl.gz"
+    with pytest.raises(RuntimeError, match="self-verification failed"):
+        _verify_then_publish(snap, out, {"a": "0" * 64}, 1)
+
+
+def test_fcw_failed_run_cleans_temp_residue(tmp_path, monkeypatch):
+    catalog = _retired_catalog_for_fail_closed(tmp_path)
+    monkeypatch.setattr(
+        "company_wiki.source_catalog.archive_retired_evidence._count_retired",
+        lambda conn: 999)
+    root = tmp_path / "manifests"
+    with pytest.raises(RuntimeError, match="reconciliation failed"):
+        archive_retired_evidence(catalog.config.database_path, root, now=NOW)
+    assert list((root / "archive").rglob("*.partial-*")) == []
+    assert list((root / "archive").rglob("*.manifest.json")) == []
